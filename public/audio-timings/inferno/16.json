196.06}]},{"id":21,"speaker":"three_florentines","text":"If it costs you so little effort other times\nto satisfy someone's question,\"","startTime":196.06,"endTime":200.38,"words":[{"word":"If","start":196.06,"end":196.26},{"word":"it","start":196.26,"end":196.38},{"word":"costs","start":196.38,"end":196.7},{"word":"you","start":196.7,"end":196.94},{"word":"so","start":196.94,"end":197.18},{"word":"little","start":197.18,"end":197.5},{"word":"effort","start":197.5,"end":197.9},{"word":"other","start":197.9,"end":198.34},{"word":"times","start":198.34,"end":198.58},{"word":"to","start":198.58,"end":198.7},{"word":"satisfy","start":198.7,"end":199.26},{"word":"someone's","start":199.26,"end":199.66},{"word":"question,\"","start":199.66,"end":200.38}]},{"id":22,"speaker":"narrator","text":"they all replied,","startTime":200.38,"endTime":201.98,"words":[{"word":"they","start":200.62,"end":200.86},{"word":"all","start":200.86,"end":201.1},{"word":"replied,","start":201.1,"end":201.98}]},{"id":23,"speaker":"three_florentines","text":"\"how fortunate you are to speak so freely!\nTherefore, if you escape from these dark places\nand return to see the beautiful stars,\nwhen it pleases you to say 'I was there,'\nbe sure to speak of us to the living.","startTime":201.98,"endTime":215.18,"words":[{"word":"\"how","start":201.98,"end":202.38},{"word":"fortunate","start":202.38,"end":202.94},{"word":"you","start":202.94,"end":203.1},{"word":"are","start":203.1,"end":203.22},{"word":"to","start":203.22,"end":203.34},{"word":"speak","start":203.34,"end":203.66},{"word":"so","start":203.66,"end":203.98},{"word":"freely!","start":203.98,"end":205.02},{"word":"Therefore,","start":205.02,"end":205.82},{"word":"if","start":205.82,"end":205.94},{"word":"you","start":205.94,"end":206.06},{"word":"escape","start":206.06,"end":206.54},{"word":"from","start":206.54,"end":206.74},{"word":"these","start":206.74,"end":206.94},{"word":"dark","start":206.94,"end":207.18},{"word":"places","start":2