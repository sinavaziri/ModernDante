{"cantica":"inferno","cantoNumber":16,"title":"Canto XVI","totalDuration":338.246,"segments":[{"id":1,"speaker":"narrator","text":"Now I could hear the thunderous reverberation\nof water cascading into the circle below,\na sound like the deep humming of a thousand beehives,\nwhen three shadows broke away from a group of souls\npassing beneath the rain of burning flakes.\nThey ran toward us, and each one cried out:","startTime":0,"endTime":18.56,"words":[{"word":"Now","start":0.32,"end":0.64},{"word":"I","start":0.64,"end":0.8},{"word":"could","start":0.8,"end":0.96},{"word":"hear","start":0.96,"end":1.2},{"word":"the","start":1.2,"end":1.44},{"word":"thunderous","start":1.44,"end":2},{"word":"reverberation","start":2,"end":2.88},{"word":"of","start":2.88,"end":3.04},{"word":"water","start":3.04,"end":3.52},{"word":"cascading","start":3.52,"end":4.36},{"word":"into","start":4.36,"end":4.56},{"word":"the","start":4.56,"end":4.8},{"word":"circle","start":4.8,"end":5.16},{"word":"below,","start":5.16,"end":6.08},{"word":"a","start":6.08,"end":6.347},{"word":"sound","start":6.347,"end":6.56},{"word":"like","start":6.56,"end":6.72},{"word":"the","start":6.72,"end":7},{"word":"deep","start":7,"end":7.28},{"word":"humming","start":7.28,"end":7.64},{"word":"of","start":7.64,"end":7.92},{"word":"a","start":7.92,"end":8.027},{"word":"thousand","start":8.027,"end":8.52},{"word":"beehives,","start":8.52,"end":9.68},{"word":"when","start":9.68,"end":10.04},{"word":"three","start":10.04,"end":10.32},{"word":"shadows","start":10.32,"end":10.84},{"word":"broke","start":10.84,"end":11.12},{"word":"away","start":11.12,"end":11.52},{"word":"from","start":11.52,"end":11.64},{"word":"a","start":11.64,"end":11.8},{"word":"group","start":11.8,"end":12},{"word":"of","start":12,"end":12.16},{"word":"souls","start":12.16,"end":12.76},{"word":"passing","start":12.76,"end":13.093},{"word":"beneath","start":13.093,"end":13.44},{"word":"the","start":13.44,"end":13.68},{"word":"rain","start":13.68