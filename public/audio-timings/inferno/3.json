.587},{"word":"I","start":176.587,"end":176.8},{"word":"understood","start":176.8,"end":177.28},{"word":"and","start":177.28,"end":177.52},{"word":"was","start":177.52,"end":177.76},{"word":"certain","start":177.76,"end":178.72},{"word":"This","start":178.72,"end":178.96},{"word":"was","start":178.96,"end":179.12},{"word":"the","start":179.12,"end":179.36},{"word":"sect","start":179.36,"end":179.6},{"word":"of","start":179.6,"end":179.92},{"word":"worthless","start":179.92,"end":180.32},{"word":"wretches","start":180.32,"end":181.067},{"word":"Hateful","start":181.067,"end":181.36},{"word":"to","start":181.36,"end":181.68},{"word":"God","start":181.68,"end":181.84},{"word":"and","start":181.84,"end":181.92},{"word":"to","start":181.92,"end":182.08},{"word":"his","start":182.08,"end":182.24},{"word":"enemies.","start":182.24,"end":183.68},{"word":"These","start":183.68,"end":183.88},{"word":"miserable","start":183.88,"end":184.4},{"word":"souls,","start":184.4,"end":184.96},{"word":"who","start":184.96,"end":185.2},{"word":"were","start":185.2,"end":185.52},{"word":"never","start":185.52,"end":185.68},{"word":"truly","start":185.68,"end":186.72},{"word":"alive,","start":186.72,"end":186.96},{"word":"Were","start":186.96,"end":187.04},{"word":"naked","start":187.04,"end":187.68},{"word":"and","start":187.68,"end":188},{"word":"constantly","start":188,"end":188.56},{"word":"stung","start":188.56,"end":188.96},{"word":"By","start":188.96,"end":189.36},{"word":"wasps","start":189.36,"end":189.6},{"word":"and","start":189.6,"end":189.84},{"word":"hornets.","start":189.84,"end":190.88},{"word":"The","start":190.88,"end":191.12},{"word":"insects","start":191.12,"end":191.6},{"word":"streaked","start":191.6,"end":192.08},{"word":"their","start":192.08,"end":192.48},{"word":"faces","start":192.48,"end":192.72},{"word":"with","start":192.72,"end":193.36},{"word":"blood","start":193.36,"end":193.76},{"word":"Which,","start":193.76,"end":194.08},{"word":"mixed","start":194.08,"end":194.32},{"word":"with","start":194.32,"end":194.48},{"word":"tears,","start":194.48,"end":195.28},{"word":"fell","start":195.28,"end":195.44},{"word":"to","start":195.44,"end":195.68},{"word":"their","start":195.68,"end":195.88},{"word":"feet","start":195.88,"end":196.16},{"word":"Where","start":196.16,"end":196.48},{"word":"disgusting","start":196.48,"end":197.28},{"word":"worms","start":197.28,"end":197.68},{"word":"gathered","start":197.68,"end":197.84},{"word":"it","start":197.84,"end":198.72},{"word":"up.","start":198.72,"end":199.04},{"word":"When","start":199.04,"end":199.227},{"word":"I","start":199.227,"end":199.28},{"word":"looked","start":199.28,"end":199.6},{"word":"farther","start":199.6,"end":200.48},{"word":"ahead,","start":200.48,"end":200.68},{"word":"I","start":200.68,"end":200.8},{"word":"saw","start":200.8,"end":201.2},{"word":"people","start":201.2,"end":201.36},{"word":"on","start":201.36,"end":201.52},{"word":"the","start":201.52,"end":201.76},{"word":"bank","start":201.76,"end":201.84},{"word":"of","start":201.84,"end":202.04},{"word":"a","start":202.04,"end":202.32},{"word":"great","start":202.32,"end":202.72},{"word":"river.","start":202.72,"end":202.88}]},{"id":14,"speaker":"dante","text":"Master,\" I said, \"please grant me this—\nLet me know who these are, and what law\nMakes them seem so eager to cross over,\nAs I can see in this dim light.","startTime":202.88,"endTime":212.72,"words":[{"word":"Master,\"","start":203.04,"end":203.84},{"word":"I","start":203.84,"end":204.04},{"word":"said,","start":204.04,"end":204.56},{"word":"\"please","start":204.56,"end":205.04},{"word":"grant","start":205.04,"end":205.36},{"word":"me","start":205.36,"end":205.56},{"word":"this—","start":205.56,"end":206.32},{"word":"Let","start":206.32,"end":206.48},{"word":"me","start":206.48,"end":206.64},{"word":"know","start":206.64,"end":206.92},{"word":"who","start":206.92,"end":207.16},{"word":"these","start":207.16,"end":207.36},{"word":"are,","start":207.36,"end":207.947},{"word":"and","start":207.947,"end":208.12},{"word":"what","start":208.12,"end":208.36},{"word":"law","start":208.36,"end":208.56},{"word":"Makes","start":208.56,"end":208.8},{"word":"them","start":208.8,"end":209},{"word":"seem","start":209,"end":209.4},{"word":"so","start":209.4,"end":209.6},{"word":"eager","start":209.6,"end":209.96},{"word":"to","start":209.96,"end":210.08},{"word":"cross","start":210.08,"end":210.4},{"word":"over,","start":210.4,"end":210.987},{"word":"As","start":210.987,"end":211.12},{"word":"I","start":211.12,"end":211.28},{"word":"can","start":211.28,"end":211.44},{"word":"see","start":211.44,"end":211.6},{"word":"in","start":211.6,"end":211.8},{"word":"this","start":211.8,"end":212},{"word":"dim","start":212,"end":212.16},{"word":"light.","start":212.16,"end":212.72}]},{"id":15,"speaker":"narrator","text":"He answered:","startTime":212.72,"endTime":213.84,"words":[{"word":"He","start":212.88,"end":213.04},{"word":"answered:","start":213.04,"end":213.84}]},{"id":16,"speaker":"virgil","text":"These things will all be revealed\nWhen we stop walking\nOn the sorrowful shore of Acheron.","startTime":213.84,"endTime":220.08,"words":[{"word":"These","start":213.84,"end":214.24},{"word":"things","start":214.24,"end":214.68},{"word":"will","start":214.68,"end":214.88},{"word":"all","start":214.88,"end":215.2},{"word":"be","start":215.2,"end":215.36},{"word":"revealed","start":215.36,"end":216.24},{"word":"When","start":216.24,"end":216.48},{"word":"we","start":216.48,"end":216.8},{"word":"stop","start":216.8,"end":217.04},{"word":"walking","start":217.04,"end":217.56},{"word":"On","start":217.56,"end":217.68},{"word":"the","start":217.68,"end":217.92},{"word":"sorrowful","start":217.92,"end":218.56},{"word":"shore","start":218.56,"end":219.04},{"word":"of","start":219.04,"end":219.2},{"word":"Acheron.","start":219.2,"end":220.08}]},{"id":17,"speaker":"narrator","text":"Then, my eyes cast down in shame,\nFearing my words had annoyed him,\nI kept silent until we reached the river.\nAnd look! Coming toward us in a boat\nWas an old man, his hair white with age,\nShouting:","startTime":220.08,"endTime":233.92,"words":[{"word":"Then,","start":220.24,"end":221.12},{"word":"my","start":221.12,"end":221.36},{"word":"eyes","start":221.36,"end":221.84},{"word":"cast","start":221.84,"end":222.08},{"word":"down","start":222.08,"end":222.32},{"word":"in","start":222.32,"end":222.56},{"word":"shame,","start":222.56,"end":223.36},{"word":"Fearing","start":223.36,"end":223.76},{"word":"my","start":223.76,"end":223.92},{"word":"words","start":223.92,"end":224.2},{"word":"had","start":224.2,"end":224.32},{"word":"annoyed","start":224.32,"end":224.8},{"word":"him,","start":224.8,"end":225.6},{"word":"I","start":225.6,"end":225.8},{"word":"kept","start":225.8,"end":226},{"word":"silent","start":226,"end":226.56},{"word":"until","start":226.56,"end":226.8},{"word":"we","start":226.8,"end":226.96},{"word":"reached","start":226.96,"end":227.2},{"word":"the","start":227.2,"end":227.44},{"word":"river.","start":227.44,"end":228.08},{"word":"And","start":228.08,"end":228.36},{"word":"look!","start":228.36,"end":229.04},{"word":"Coming","start":229.04,"end":229.36},{"word":"toward","start":229.36,"end":229.6},{"word":"us","start":229.6,"end":229.72},{"word":"in","start":229.72,"end":229.92},{"word":"a","start":229.92,"end":230.08},{"word":"boat","start":230.08,"end":230.24},{"word":"Was","start":230.24,"end":230.44},{"word":"an","start":230.44,"end":230.64},{"word":"old","start":230.64,"end":231.2},{"word":"man,","start":231.2,"end":231.68},{"word":"his","start":231.68,"end":231.96},{"word":"hair","start":231.96,"end":232.28},{"word":"white","start":232.28,"end":232.48},{"word":"with","start":232.48,"end":232.8},{"word":"age,","start":232.8,"end":233.36},{"word":"Shouting:","start":233.36,"end":233.92}]},{"id":18,"speaker":"charon","text":"\"Woe to you, you corrupt souls!\nNever hope to see the heavens again!\nI come to ferry you to the other shore,\nInto eternal darkness, fire, and ice.\nAnd you there—you living soul—\nGet away from these dead ones!\"","startTime":233.92,"endTime":251.36,"words":[{"word":"\"Woe","start":233.92,"end":234.56},{"word":"to","start":234.56,"end":234.8},{"word":"you,","start":234.8,"end":235.44},{"word":"you","start":235.44,"end":235.6},{"word":"corrupt","start":235.6,"end":236.32},{"word":"souls!","start":236.32,"end":237.44},{"word":"Never","start":237.44,"end":237.76},{"word":"hope","start":237.76,"end":238.08},{"word":"to","start":238.08,"end":238.24},{"word":"see","start":238.24,"end":238.4},{"word":"the","start":238.4,"end":238.56},{"word":"heavens","start":238.56,"end":238.96},{"word":"again!","start":238.96,"end":240},{"word":"I","start":240,"end":240.32},{"word":"come","start":240.32,"end":240.56},{"word":"to","start":240.56,"end":240.8},{"word":"ferry","start":240.8,"end":241.2},{"word":"you","start":241.2,"end":241.36},{"word":"to","start":241.36,"end":241.52},{"word":"the","start":241.52,"end":241.6},{"word":"other","start":241.6,"end":241.92},{"word":"shore,","start":241.92,"end":242.72},{"word":"Into","start":242.72,"end":243.04},{"word":"eternal","start":243.04,"end":243.76},{"word":"darkness,","start":243.76,"end":244.64},{"word":"fire,","start":244.64,"end":245.28},{"word":"and","start":245.28,"end":245.6},{"word":"ice.","start":245.6,"end":246.56},{"word":"And","start":246.56,"end":246.8},{"word":"you","start":246.8,"end":247.04},{"word":"there—you","start":247.04,"end":248},{"word":"living","start":248,"end":248.48},{"word":"soul—","start":248.48,"end":249.36},{"word":"Get","start":249.36,"end":249.6},{"word":"away","start":249.6,"end":249.84},{"word":"from","start":249.84,"end":250.12},{"word":"these","start":250.12,"end":250.4},{"word":"dead","start":250.4,"end":250.64},{"word":"ones!\"","start":250.64,"end":251.36}]},{"id":19,"speaker":"narrator","text":"But when he saw I didn't move,\nHe said:","startTime":251.36,"endTime":254.24,"words":[{"word":"But","start":251.441,"end":251.681},{"word":"when","start":251.681,"end":251.881},{"word":"he","start":251.881,"end":252.041},{"word":"saw","start":252.041,"end":252.401},{"word":"I","start":252.401,"end":252.481},{"word":"didn't","start":252.481,"end":253.001},{"word":"move,","start":253.001,"end":253.601},{"word":"He","start":253.601,"end":253.881},{"word":"said:","start":253.881,"end":254.24}]},{"id":20,"speaker":"charon","text":"\"By other routes, through other gates\nYou'll reach the shore, not here.\nA lighter boat must carry you.\"","startTime":254.24,"endTime":261.52,"words":[{"word":"\"By","start":254.24,"end":254.56},{"word":"other","start":254.56,"end":254.88},{"word":"routes,","start":254.88,"end":255.72},{"word":"through","start":255.72,"end":255.92},{"word":"other","start":255.92,"end":256.16},{"word":"gates","start":256.16,"end":257.04},{"word":"You'll","start":257.04,"end":257.28},{"word":"reach","start":257.28,"end":257.52},{"word":"the","start":257.52,"end":257.68},{"word":"shore,","start":257.68,"end":258.44},{"word":"not","start":258.44,"end":258.64},{"word":"here.","start":258.64,"end":259.52},{"word":"A","start":259.52,"end":259.68},{"word":"lighter","start":259.68,"end":260.08},{"word":"boat","start":260.08,"end":260.48},{"word":"must","start":260.48,"end":260.72},{"word":"carry","start":260.72,"end":261.12},{"word":"you.\"","start":261.12,"end":261.52}]},{"id":21,"speaker":"narrator","text":"My guide answered him:","startTime":261.52,"endTime":263.2,"words":[{"word":"My","start":261.68,"end":262.04},{"word":"guide","start":262.04,"end":262.32},{"word":"answered","start":262.32,"end":262.72},{"word":"him:","start":262.72,"end":263.2}]},{"id":22,"speaker":"virgil","text":"Don't torment yourself, Charon.\nThis is willed where there is power\nTo do what is willed. Ask no more questions.","startTime":263.2,"endTime":271.44,"words":[{"word":"Don't","start":263.2,"end":263.64},{"word":"torment","start":263.64,"end":264.12},{"word":"yourself,","start":264.12,"end":264.56},{"word":"Charon.","start":264.56,"end":265.68},{"word":"This","start":265.68,"end":265.84},{"word":"is","start":265.84,"end":266.08},{"word":"willed","start":266.08,"end":266.72},{"word":"where","start":266.72,"end":266.96},{"word":"there","start":266.96,"end":267.12},{"word":"is","start":267.12,"end":267.36},{"word":"power","start":267.36,"end":267.76},{"word":"To","start":267.76,"end":268},{"word":"do","start":268,"end":268.32},{"word":"what","start":268.32,"end":268.48},{"word":"is","start":268.48,"end":268.72},{"word":"willed.","start":268.72,"end":269.68},{"word":"Ask","start":269.68,"end":270.08},{"word":"no","start":270.08,"end":270.32},{"word":"more","start":270.32,"end":270.56},{"word":"questions.","start":270.56,"end":271.44}]},{"id":23,"speaker":"narrator","text":"At this, the woolly cheeks fell silent\nOn the ferryman of the livid marsh,\nWho had wheels of flame around his eyes.\nBut all those weary, naked souls\nChanged color and gnashed their teeth\nAs soon as they heard his cruel words.\nThey cursed God and their parents,\nThe human race, the place, the time,\nThe seed of their conception and their birth.\nThen, weeping bitterly, they all gathered together\nOn the accursed shore\nThat awaits everyone who doesn't fear God.\nCharon the demon, with glowing eyes,\nSignals and collects them all,\nStrikes with his oar anyone who lingers.\nAs autumn leaves fall away,\nFirst one, then another, until the branch\nGives all its spoils to the earth,\nSo the evil seed of Adam\nThrows itself from that shore one by one\nAt his signals, like a bird to its call.\nThey depart across the dark water,\nAnd before they land on the other side,\nA new crowd assembles here again.","startTime":271.44,"endTime":330.56,"words":[{"word":"At","start":271.521,"end":271.881},{"word":"this,","start":271.881,"end":272.481},{"word":"the","start":272.481,"end":272.601},{"word":"woolly","start":272.601,"end":272.961},{"word":"cheeks","start":27