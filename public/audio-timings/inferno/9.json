01,"end":12.761},{"word":"ahead","start":12.761,"end":13.28}]},{"id":2,"speaker":"narrator","text":"The black air could not carry him far through that heavy fog.","startTime":13.28,"endTime":17.36,"words":[{"word":"The","start":13.361,"end":13.521},{"word":"black","start":13.521,"end":13.921},{"word":"air","start":13.921,"end":14.321},{"word":"could","start":14.321,"end":14.561},{"word":"not","start":14.561,"end":14.961},{"word":"carry","start":14.961,"end":15.241},{"word":"him","start":15.241,"end":15.441},{"word":"far","start":15.441,"end":15.841},{"word":"through","start":15.841,"end":16.121},{"word":"that","start":16.121,"end":16.401},{"word":"heavy","start":16.401,"end":16.641},{"word":"fog.","start":16.641,"end":17.36}]},{"id":3,"speaker":"virgil","text":"We must still win this fight, Otherwise... She who offered herself to us...\nOh, how I long for someone to arrive!","startTime":17.36,"endTime":26.64,"words":[{"word":"We","start":17.36,"end":17.68},{"word":"must","start":17.68,"end":18},{"word":"still","start":18,"end":18.4},{"word":"win","start":18.4,"end":18.76},{"word":"this","start":18.76,"end":18.96},{"word":"fight,","start":18.96,"end":19.68},{"word":"Otherwise...","start":19.68,"end":21.04},{"word":"She","start":21.04,"end":21.36},{"word":"who","start":21.36,"end":21.6},{"word":"offered","start":21.6,"end":22},{"word":"herself","start":22,"end":22.4},{"word":"to","start":22.4,"end":22.56},{"word":"us...","start":22.56,"end":23.52},{"word":"Oh,","start":23.52,"end":24.08},{"word":"how","start":24.08,"end":24.32},{"word":"I","start":24.32,"end":24.64},{"word":"long","start":24.64,"end":25.04},{"word":"for","start":25.04,"end":25.28},{"word":"someone","start":25.28,"end":25.6},{"word":"to","start":25.6,"end":25.76},{"word":"arrive!","start":25.76,"end":26.64}]},{"id":4,"speaker":"narrator","text":"I could tell from the moment he began\nthat he was covering up his first words\nwith what came after—\nthey were completely different from what he'd started to