osca,\nand the others who set their minds on doing good—\ntell me where they are, help me to know them.\nI'm desperate to learn whether Heaven sweetens them\nor Hell poisons them.","startTime":217.28,"endTime":238.24,"words":[{"word":"I","start":217.44,"end":217.6},{"word":"want","start":217.6,"end":217.76},{"word":"you","start":217.76,"end":217.92},{"word":"to","start":217.92,"end":218.04},{"word":"teach","start":218.04,"end":218.32},{"word":"me","start":218.32,"end":218.64},{"word":"more,\"","start":218.64,"end":219.28},{"word":"I","start":219.28,"end":219.44},{"word":"said,","start":219.44,"end":220},{"word":"\"and","start":220,"end":220.24},{"word":"give","start":220.24,"end":220.4},{"word":"me","start":220.4,"end":220.56},{"word":"the","start":220.56,"end":220.8},{"word":"gift","start":220.8,"end":221.04},{"word":"of","start":221.04,"end":221.16},{"word":"further","start":221.16,"end":221.52},{"word":"words.","start":221.52,"end":222.56},{"word":"Farinata","start":222.56,"end":223.28},{"word":"and","start":223.28,"end":223.413},{"word":"Tegghiaio,","start":223.413,"end":224.2},{"word":"who","start":224.2,"end":224.32},{"word":"were","start":224.32,"end":224.64},{"word":"so","start":224.64,"end":224.88},{"word":"worthy,","start":224.88,"end":225.68},{"word":"Jacopo","start":225.68,"end":226.04},{"word":"Rusticucci,","start":226.04,"end":227.04},{"word":"Arrigo,","start":227.04,"end":227.68},{"word":"and","start":227.68,"end":227.88},{"word":"Mosca,","start":227.88,"end":228.6},{"word":"and","start":228.6,"end":228.72},{"word":"the","start":228.72,"end":228.88},{"word":"others","start":228.88,"end":229.2},{"word":"who","start":229.2,"end":229.36},{"word":"set","start":229.36,"end":229.56},{"word":"their","start":229.56,"end":229.787},{"word":"minds","start":229.787,"end":230.08},{"word":"on","start":230.08,"end":230.32},{"word":"doing","start":230.32,"end":230.6},{"word":"good—","start":230.6,"end":231.44},{"word":"tell","start":231.44,"end":231.6},{"word":"me","