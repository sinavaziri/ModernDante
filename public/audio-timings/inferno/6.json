},{"word":"against","start":103.921,"end":104.161},{"word":"the","start":104.161,"end":104.441},{"word":"ground","start":104.441,"end":104.881},{"word":"except","start":104.881,"end":105.281},{"word":"for","start":105.281,"end":105.521},{"word":"one,","start":105.521,"end":106.241},{"word":"who","start":106.241,"end":106.401},{"word":"sat","start":106.401,"end":106.561},{"word":"up","start":106.561,"end":106.801},{"word":"straight","start":106.801,"end":107.281},{"word":"as","start":107.281,"end":107.521},{"word":"soon","start":107.521,"end":107.641},{"word":"as","start":107.641,"end":107.761},{"word":"he","start":107.761,"end":107.974},{"word":"saw","start":107.974,"end":108.161},{"word":"us","start":108.161,"end":108.441},{"word":"passing","start":108.441,"end":108.881},{"word":"by.","start":108.881,"end":109.2}]},{"id":3,"speaker":"ciacco","text":"You who are being led through this Hell,","startTime":109.2,"endTime":112.16,"words":[{"word":"You","start":109.2,"end":109.92},{"word":"who","start":109.92,"end":110.16},{"word":"are","start":110.16,"end":110.36},{"word":"being","start":110.36,"end":110.64},{"word":"led","start":110.64,"end":110.96},{"word":"through","start":110.96,"end":111.2},{"word":"this","start":111.2,"end":111.52},{"word":"Hell,","start":111.52,"end":112.16}]},{"id":4,"speaker":"narrator","text":"he said to me,","startTime":112.16,"endTime":113.36,"words":[{"word":"he","start":112.32,"end":112.48},{"word":"said","start":112.48,"end":112.72},{"word":"to","start":112.72,"end":112.92},{"word":"me,","start":112.92,"end":113.36}]},{"id":5,"speaker":"ciacco","text":"\"remember me if you can.\nYou were created before I was destroyed.\"","startTime":113.36,"endTime":118.48,"words":[{"word":"\"remember","start":113.36,"end":114},{"word":"me","start":114,"end":114.16},{"word":"if","start":114.16,"end":114.32},{"word":"you","start":114.32,"end":114.48},{"word":"can.","start":114.48,"end":115.68},{"word":"You","start":115.68,"end":115.84},{"word":"were","sta