1.601},{"word":"suffer","start":151.601,"end":152.161},{"word":"for","start":152.161,"end":152.321},{"word":"stealing","start":152.321,"end":152.761},{"word":"the","start":152.761,"end":152.881},{"word":"Palladium.\"","start":152.881,"end":153.6}]},{"id":4,"speaker":"dante","text":"If those spirits in the flames can speak,","startTime":153.6,"endTime":156.32,"words":[{"word":"If","start":153.685,"end":153.965},{"word":"those","start":153.965,"end":154.165},{"word":"spirits","start":154.165,"end":154.645},{"word":"in","start":154.645,"end":154.725},{"word":"the","start":154.725,"end":154.885},{"word":"flames","start":154.885,"end":155.285},{"word":"can","start":155.285,"end":155.605},{"word":"speak,","start":155.605,"end":156.32}]},{"id":5,"speaker":"dante","text":"I said, \"Master, I beg you urgently—\nand let my plea count for a thousand—\ndon't refuse to wait here\nuntil that twin-horned flame comes closer.\nYou see how I lean toward it with longing.\"","startTime":156.32,"endTime":168.48,"words":[{"word":"I","start":156.56,"end":156.76},{"word":"said,","start":156.76,"end":157.36},{"word":"\"Master,","start":157.36,"end":158.24},{"word":"I","start":158.24,"end":158.52},{"word":"beg","start":158.52,"end":158.76},{"word":"you","start":158.76,"end":158.96},{"word":"urgently—","start":158.96,"end":159.867},{"word":"and","start":159.867,"end":160},{"word":"let","start":160,"end":160.16},{"word":"my","start":160.16,"end":160.32},{"word":"plea","start":160.32,"end":160.68},{"word":"count","start":160.68,"end":160.84},{"word":"for","start":160.84,"end":161.12},{"word":"a","start":161.12,"end":161.227},{"word":"thousand—","start":161.227,"end":162.133},{"word":"don't","start":162.133,"end":162.48},{"word":"refuse","start":162.48,"end":162.88},{"word":"to","start":162.88,"end":163.08},{"word":"wait","start":163.08,"end":163.28},{"word":"here","start":163.28,"end":163.52},{"word":"until","start":163.52,"end":163.8},{"word":"that","start":163.8,"end":164},{"word":"twin-horne