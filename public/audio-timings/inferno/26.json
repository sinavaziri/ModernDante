you","start":178.72,"end":178.88},{"word":"want","start":178.88,"end":179.04},{"word":"to","start":179.04,"end":179.2},{"word":"know.","start":179.2,"end":180},{"word":"But","start":180,"end":180.16},{"word":"they","start":180.16,"end":180.32},{"word":"might","start":180.32,"end":180.56},{"word":"scorn","start":180.56,"end":181.04},{"word":"your","start":181.04,"end":181.2},{"word":"words,","start":181.2,"end":182.04},{"word":"since","start":182.04,"end":182.24},{"word":"they","start":182.24,"end":182.4},{"word":"were","start":182.4,"end":182.56},{"word":"Greeks.","start":182.56,"end":183.28}]},{"id":8,"speaker":"narrator","text":"When the flame reached the spot\nwhere my leader judged the time was right,\nI heard him speak like this:","startTime":183.28,"endTime":189.36,"words":[{"word":"When","start":183.52,"end":183.68},{"word":"the","start":183.68,"end":183.84},{"word":"flame","start":183.84,"end":184.2},{"word":"reached","start":184.2,"end":184.56},{"word":"the","start":184.56,"end":184.8},{"word":"spot","start":184.8,"end":185.04},{"word":"where","start":185.04,"end":185.28},{"word":"my","start":185.28,"end":185.44},{"word":"leader","start":185.44,"end":185.84},{"word":"judged","start":185.84,"end":186.2},{"word":"the","start":186.2,"end":186.32},{"word":"time","start":186.32,"end":186.68},{"word":"was","start":186.68,"end":186.88},{"word":"right,","start":186.88,"end":187.76},{"word":"I","start":187.76,"end":187.84},{"word":"heard","start":187.84,"end":188},{"word":"him","start":188,"end":188.24},{"word":"speak","start":188.24,"end":188.56},{"word":"like","start":188.56,"end":188.8},{"word":"this:","start":188.8,"end":189.36}]},{"id":9,"speaker":"virgil","text":"You who are two within one fire,\nif I earned anything from you while I lived,\nif I earned much or little from you\nwhen I wrote those lofty verses in the world,\ndon't move on—let one of you tell us\nwhere he went, lost, to meet his death.","startTime":189.36,"endTime":206,"words":[{"word":"You","st