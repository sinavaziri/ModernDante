","start":124.32,"end":124.68},{"word":"in","start":124.68,"end":124.8},{"word":"that","start":124.8,"end":125.04},{"word":"flame","start":125.04,"end":125.6},{"word":"split","start":125.6,"end":125.8},{"word":"at","start":125.8,"end":125.92},{"word":"the","start":125.92,"end":126.08},{"word":"top","start":126.08,"end":126.4},{"word":"like","start":126.4,"end":126.72},{"word":"fire","start":126.72,"end":127.12},{"word":"rising","start":127.12,"end":127.52},{"word":"from","start":127.52,"end":127.68},{"word":"the","start":127.68,"end":127.84},{"word":"funeral","start":127.84,"end":128.24},{"word":"pyre","start":128.24,"end":128.64},{"word":"where","start":128.64,"end":128.8},{"word":"Eteocles","start":128.8,"end":129.52},{"word":"lay","start":129.52,"end":129.68},{"word":"with","start":129.68,"end":129.84},{"word":"his","start":129.84,"end":130},{"word":"brother?","start":130,"end":130.56}]},{"id":3,"speaker":"narrator","text":"He answered: \"Ulysses and Diomedes\nare tormented in there together,\nracing toward punishment as they once raced to war.\nWithin their flame they mourn\nthe trick of the wooden horse that opened the door\nfrom which Rome's noble bloodline issued forth.\nThey weep for the deception that left\nDeidamia still mourning her dead Achilles,\nand they suffer for stealing the Palladium.\"","startTime":130.56,"endTime":153.6,"words":[{"word":"He","start":130.641,"end":131.041},{"word":"answered:","start":131.041,"end":131.841},{"word":"\"Ulysses","start":131.841,"end":132.561},{"word":"and","start":132.561,"end":132.721},{"word":"Diomedes","start":132.721,"end":133.441},{"word":"are","start":133.441,"end":133.601},{"word":"tormented","start":133.601,"end":134.241},{"word":"in","start":134.241,"end":134.401},{"word":"there","start":134.401,"end":134.561},{"word":"together,","start":134.561,"end":135.521},{"word":"racing","start":135.521,"end":135.961},{"word":"toward","start":135.961,"end":136.321},{"word":"punishment","start":136.321,"end":136.881},{"