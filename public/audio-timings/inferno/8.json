","start":331.235,"end":331.475},{"word":"it","start":331.475,"end":331.715},{"word":"once","start":331.715,"end":331.995},{"word":"at","start":331.995,"end":332.115},{"word":"a","start":332.115,"end":332.315},{"word":"less","start":332.315,"end":332.515},{"word":"secret","start":332.515,"end":332.995},{"word":"gate","start":332.995,"end":333.355},{"word":"that","start":333.355,"end":333.595},{"word":"still","start":333.595,"end":333.875},{"word":"stands","start":333.875,"end":334.435},{"word":"without","start":334.435,"end":334.675},{"word":"its","start":334.675,"end":334.835},{"word":"locks.","start":334.835,"end":335.875},{"word":"You","start":335.875,"end":336.195},{"word":"saw","start":336.195,"end":336.515},{"word":"the","start":336.515,"end":336.755},{"word":"deadly","start":336.755,"end":337.315},{"word":"inscription","start":337.315,"end":337.795},{"word":"above","start":337.795,"end":338.035},{"word":"it.","start":338.035,"end":338.675},{"word":"And","start":338.675,"end":339.115},{"word":"already,","start":339.115,"end":339.915},{"word":"descending","start":339.915,"end":340.315},{"word":"this","start":340.315,"end":340.555},{"word":"side","start":340.555,"end":340.755},{"word":"of","start":340.755,"end":340.835},{"word":"it,","start":340.835,"end":341.395},{"word":"passing","start":341.395,"end":341.795},{"word":"through","start":341.795,"end":341.915},{"word":"the","start":341.915,"end":342.115},{"word":"circles","start":342.115,"end":342.595},{"word":"without","start":342.595,"end":343.195},{"word":"escort,","start":343.195,"end":343.955},{"word":"comes","start":343.955,"end":344.275},{"word":"one","start":344.275,"end":344.595},{"word":"who","start":344.595,"end":344.795},{"word":"will","start":344.795,"end":344.995},{"word":"open","start":344.995,"end":345.435},{"word":"this","start":345.435,"end":345.635},{"word":"city","start":345.635,"end":345.955},{"word":"to","start":345.955,"end":346.115},{"word":"us.\"","start":346.115,"end":346.675}]}]}