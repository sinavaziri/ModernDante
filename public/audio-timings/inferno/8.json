{"word":"before","start":83.466,"end":83.706},{"word":"me,","start":83.706,"end":84.226},{"word":"caked","start":84.226,"end":84.586},{"word":"with","start":84.586,"end":84.826},{"word":"mud:","start":84.826,"end":85.385}]},{"id":9,"speaker":"filippo_argenti","text":"Who are you, coming here before your time?","startTime":85.385,"endTime":88.185,"words":[{"word":"Who","start":85.385,"end":85.705},{"word":"are","start":85.705,"end":85.945},{"word":"you,","start":85.945,"end":86.505},{"word":"coming","start":86.505,"end":86.825},{"word":"here","start":86.825,"end":87.145},{"word":"before","start":87.145,"end":87.385},{"word":"your","start":87.385,"end":87.745},{"word":"time?","start":87.745,"end":88.185}]},{"id":10,"speaker":"dante","text":"Though I come,\" I replied, \"I do not stay.\nBut who are you, so filthy and degraded?","startTime":88.185,"endTime":94.985,"words":[{"word":"Though","start":88.425,"end":88.665},{"word":"I","start":88.665,"end":88.825},{"word":"come,\"","start":88.825,"end":89.705},{"word":"I","start":89.705,"end":89.785},{"word":"replied,","start":89.785,"end":90.665},{"word":"\"I","start":90.665,"end":90.865},{"word":"do","start":90.865,"end":90.985},{"word":"not","start":90.985,"end":91.225},{"word":"stay.","start":91.225,"end":92.185},{"word":"But","start":92.185,"end":92.345},{"word":"who","start":92.345,"end":92.585},{"word":"are","start":92.585,"end":92.825},{"word":"you,","start":92.825,"end":93.305},{"word":"so","start":93.305,"end":93.625},{"word":"filthy","start":93.625,"end":94.025},{"word":"and","start":94.025,"end":94.185},{"word":"degraded?","start":94.185,"end":94.985}]},{"id":11,"speaker":"filippo_argenti","text":"You can see I'm one who weeps,\" he answered.","startTime":94.985,"endTime":98.585,"words":[{"word":"You","start":94.985,"end":95.265},{"word":"can","start":95.265,"end":95.465},{"word":"see","start":95.465,"end":95.945},{"word":"I'm","start":95.945,"end":96.265},{"word":"one","start":96.265,"end":96.505},{"word":"who","