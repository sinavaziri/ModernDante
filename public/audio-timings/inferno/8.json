d":"the","start":12.121,"end":12.241},{"word":"distance,","start":12.241,"end":13.201},{"word":"signals","start":13.201,"end":13.761},{"word":"flashed","start":13.761,"end":14.281},{"word":"back","start":14.281,"end":14.481},{"word":"and","start":14.481,"end":14.641},{"word":"forth—","start":14.641,"end":15.521},{"word":"lights","start":15.521,"end":15.961},{"word":"so","start":15.961,"end":16.161},{"word":"far","start":16.161,"end":16.481},{"word":"away","start":16.481,"end":16.801},{"word":"they","start":16.801,"end":17.161},{"word":"barely","start":17.161,"end":17.481},{"word":"reached","start":17.481,"end":17.801},{"word":"the","start":17.801,"end":17.921},{"word":"eye.","start":17.921,"end":19.121},{"word":"I","start":19.121,"end":19.361},{"word":"turned","start":19.361,"end":19.441},{"word":"to","start":19.441,"end":19.681},{"word":"my","start":19.681,"end":20.081},{"word":"guide,","start":20.081,"end":20.641},{"word":"hungry","start":20.641,"end":20.961},{"word":"for","start":20.961,"end":21.281},{"word":"understanding:","start":21.281,"end":22}]},{"id":3,"speaker":"dante","text":"What do those fires say to each other?\nWho made them speak across this wasteland?","startTime":22,"endTime":26.96,"words":[{"word":"What","start":22.16,"end":22.28},{"word":"do","start":22.28,"end":22.4},{"word":"those","start":22.4,"end":22.72},{"word":"fires","start":22.72,"end":23.2},{"word":"say","start":23.2,"end":23.4},{"word":"to","start":23.4,"end":23.52},{"word":"each","start":23.52,"end":23.76},{"word":"other?","start":23.76,"end":24.48},{"word":"Who","start":24.48,"end":24.64},{"word":"made","start":24.64,"end":24.8},{"word":"them","start":24.8,"end":25.12},{"word":"speak","start":25.12,"end":25.44},{"word":"across","start":25.44,"end":25.88},{"word":"this","start":25.88,"end":26.08},{"word":"wasteland?","start":26.08,"end":26.96}]},{"id":4,"speaker":"virgil","text":"Look through the murky waves,\" he answered.\n\"You can see what's coming toward us now,\nunless the marsh mist hides it from your sight.","startTime":26.96,"endTime":35.28,"words":[{"word":"Look","start":26.96,"end":27.28},{"word":"through","start":27.28,"end":27.52},{"word":"the","start":27.52,"end":27.68},{"word":"murky","start":27.68,"end":28.08},{"word":"waves,\"","start":28.08,"end":29.04},{"word":"he","start":29.04,"end":29.44},{"word":"answered.","start":29.44,"end":30.24},{"word":"\"You","start":30.24,"end":30.48},{"word":"can","start":30.48,"end":30.64},{"word":"see","start":30.64,"end":30.88},{"word":"what's","start":30.88,"end":31.2},{"word":"coming","start":31.2,"end":31.44},{"word":"toward","start":31.44,"end":31.76},{"word":"us","start":31.76,"end":31.92},{"word":"now,","start":31.92,"end":32.64},{"word":"unless","start":32.64,"end":33.04},{"word":"the","start":33.04,"end":33.2},{"word":"marsh","start":33.2,"end":33.52},{"word":"mist","start":33.52,"end":33.92},{"word":"hides","start":33.92,"end":34.24},{"word":"it","start":34.24,"end":34.4},{"word":"from","start":34.4,"end":34.56},{"word":"your","start":34.56,"end":34.8},{"word":"sight.","start":34.8,"end":35.28}]},{"id":5,"speaker":"narrator","text":"No arrow ever shot from a bowstring\nand cut through air with such swift speed\nas the small boat I saw racing toward us,\ndriven by a single ferryman who shouted:","startTime":35.28,"endTime":45.2,"words":[{"word":"No","start":35.52,"end":35.84},{"word":"arrow","start":35.84,"end":36.32},{"word":"ever","start":36.32,"end":36.64},{"word":"shot","start":36.64,"end":36.96},{"word":"from","start":36.96,"end":37.12},{"word":"a","start":37.12,"end":37.32},{"word":"bowstring","start":37.32,"end":37.88},{"word":"and","start":37.88,"end":38.08},{"word":"cut","start":38.08,"end":38.36},{"word":"through","start":38.36,"end":38.64},{"word":"air","start":38.64,"end":38.92},{"word":"with","start":38.92,"end":39.2},{"word":"such","start":39.2,"end":39.44},{"word":"swift","start":39.44,"end":39.84},{"word":"speed","start":39.84,"end":40.32},{"word":"as","start":40.32,"en