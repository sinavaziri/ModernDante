ons.","startTime":234.33,"endTime":250.89,"words":[{"word":"You","start":234.33,"end":234.65},{"word":"come","start":234.65,"end":234.89},{"word":"alone,","start":234.89,"end":235.85},{"word":"and","start":235.85,"end":236.01},{"word":"let","start":236.01,"end":236.25},{"word":"him","start":236.25,"end":236.57},{"word":"go—","start":236.57,"end":237.49},{"word":"the","start":237.49,"end":237.69},{"word":"one","start":237.69,"end":237.93},{"word":"who","start":237.93,"end":238.33},{"word":"dared","start":238.33,"end":238.89},{"word":"enter","start":238.89,"end":239.29},{"word":"this","start":239.29,"end":239.53},{"word":"domain.","start":239.53,"end":240.65},{"word":"Let","start":240.65,"end":240.93},{"word":"him","start":240.93,"end":241.13},{"word":"find","start":241.13,"end":241.49},{"word":"his","start":241.49,"end":241.77},{"word":"own","start":241.77,"end":242.25},{"word":"mad","start":242.25,"end":242.65},{"word":"way","start":242.65,"end":243.05},{"word":"back","start":243.05,"end":243.37},{"word":"if","start":243.37,"end":243.53},{"word":"he","start":243.53,"end":243.93},{"word":"can.","start":243.93,"end":244.89},{"word":"You","start":244.89,"end":245.45},{"word":"will","start":245.45,"end":245.77},{"word":"stay","start":245.77,"end":246.09},{"word":"here,","start":246.09,"end":247.21},{"word":"you","start":247.21,"end":247.45},{"word":"who","start":247.45,"end":247.73},{"word":"have","start":247.73,"end":247.93},{"word":"guided","start":247.93,"end":248.45},{"word":"him","start":248.45,"end":248.65},{"word":"through","start":248.65,"end":249.05},{"word":"such","start":249.05,"end":249.53},{"word":"dark","start":249.53,"end":250.01},{"word":"regions.","start":250.01,"end":250.89}]},{"id":25,"speaker":"narrator","text":"Think, reader, how I felt\nat the sound of those cursed words—\nI believed I would never return from here.","startTime":250.89,"endTime":258.33,"words":[{"word":"Think,","start":251.05,"end":251.61},{"word":"reader,","start":251.61,"end":252.