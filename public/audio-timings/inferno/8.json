,{"word":"before","start":83.466,"end":83.706},{"word":"me,","start":83.706,"end":84.226},{"word":"caked","start":84.226,"end":84.586},{"word":"with","start":84.586,"end":84.826},{"word":"mud:","start":84.826,"end":85.385}]},{"id":9,"speaker":"filippo_argenti","text":"Who are you, coming here before your time?","startTime":85.385,"endTime":88.185,"words":[{"word":"Who","start":85.385,"end":85.705},{"word":"are","start":85.705,"end":85.945},{"word":"you,","start":85.945,"end":86.505},{"word":"coming","start":86.505,"end":86.825},{"word":"here","start":86.825,"end":87.145},{"word":"before","start":87.145,"end":87.385},{"word":"your","start":87.385,"end":87.745},{"word":"time?","start":87.745,"end":88.185}]},{"id":10,"speaker":"dante","text":"Though I come,\" I replied, \"I do not stay.\nBut who are you, so filthy and degraded?","startTime":88.185,"endTime":94.985,"words":[{"word":"Though","start":88.425,"end":88.665},{"word":"I","start":88.665,"end":88.825},{"word":"come,\"","start":88.825,"end":89.705},{"word":"I","start":89.705,"end":89.785},{"word":"replied,","start":89.785,"end":90.665},{"word":"\"I","start":90.665,"end":90.865},{"word":"do","start":90.865,"end":90.985},{"word":"not","start":90.985,"end":91.225},{"word":"stay.","start":91.225,"end":92.185},{"word":"But","start":92.185,"end":92.345},{"word":"who","start":92.345,"end":92.585},{"word":"are","start":92.585,"end":92.825},{"word":"you,","start":92.825,"end":93.305},{"word":"so","start":93.305,"end":93.625},{"word":"filthy","start":93.625,"end":94.025},{"word":"and","start":94.025,"end":94.185},{"word":"degraded?","start":94.185,"end":94.985}]},{"id":11,"speaker":"filippo_argenti","text":"You can see I'm one who weeps,\" he answered.","startTime":94.985,"endTime":98.585,"words":[{"word":"You","start":94.985,"end":95.265},{"word":"can","start":95.265,"end":95.465},{"word":"see","start":95.465,"end":95.945},{"word":"I'm","start":95.945,"end":96.265},{"word":"one","start":96.265,"end":96.505},{"word":"who","start":96.505,"end":96.745},{"word":"weeps,\"","start":96.745,"end":97.705},{"word":"he","start":97.705,"end":97.865},{"word":"answered.","start":97.865,"end":98.585}]},{"id":12,"speaker":"dante","text":"\"Then weep and wail, accursed spirit,\" I said.\n\"Stay here in your misery—I know who you are\nbeneath all that defilement.","startTime":98.585,"endTime":107.145,"words":[{"word":"\"Then","start":98.878,"end":99.065},{"word":"weep","start":99.065,"end":99.465},{"word":"and","start":99.465,"end":99.705},{"word":"wail,","start":99.705,"end":100.185},{"word":"accursed","start":100.185,"end":100.905},{"word":"spirit,\"","start":100.905,"end":101.785},{"word":"I","start":101.785,"end":101.945},{"word":"said.","start":101.945,"end":102.665},{"word":"\"Stay","start":102.665,"end":103.065},{"word":"here","start":103.065,"end":103.305},{"word":"in","start":103.305,"end":103.505},{"word":"your","start":103.505,"end":103.705},{"word":"misery—I","start":103.705,"end":104.785},{"word":"know","start":104.785,"end":104.985},{"word":"who","start":104.985,"end":105.145},{"word":"you","start":105.145,"end":105.345},{"word":"are","start":105.345,"end":105.518},{"word":"beneath","start":105.518,"end":105.945},{"word":"all","start":105.945,"end":106.185},{"word":"that","start":106.185,"end":106.425},{"word":"defilement.","start":106.425,"end":107.145}]},{"id":13,"speaker":"narrator","text":"He reached both hands toward our boat,\nbut my alert master pushed him away:","startTime":107.145,"endTime":111.865,"words":[{"word":"He","start":107.226,"end":107.346},{"word":"reached","start":107.346,"end":107.826},{"word":"both","start":107.826,"end":108.026},{"word":"hands","start":108.026,"end":108.426},{"word":"toward","start":108.426,"end":108.746},{"word":"our","start":108.746,"end":108.906},{"word":"boat,","start":108.906,"end":109.626},{"word":"but","start":109.626,"end":109.786},{"word":"my","start":109.786,"end":110.066},{"word":"alert","start":110.066,"end":110.346},{"word":"master","start":110.346,"end":110.906},{"word":"pushed","start":110.906,"end":111.186},{"word":"him","start":111.186,"end":111.306},{"word":"away:","start":111.306,"end":111.865}]},{"id":33,"speaker":"virgil","text":"Back with the other dogs!\"","startTime":111.865,"endTime":113.665,"words":[{"word":"Back","start":111.865,"end":112.265},{"word":"with","start":112.265,"end":112.385},{"word":"the","start":112.385,"end":112.505},{"word":"other","start":112.505,"end":112.745},{"word":"dogs!\"","start":112.745,"end":113.465}]},{"id":34,"speaker":"narrator","text":"Then he embraced me,\nkissed my face, and said:","startTime":113.665,"endTime":117.425,"words":[{"word":"Then","start":113.825,"end":114.065},{"word":"he","start":114.065,"end":114.225},{"word":"embraced","start":114.225,"end":114.785},{"word":"me,","start":114.785,"end":115.505},{"word":"kissed","start":115.505,"end":115.825},{"word":"my","start":115.825,"end":116.065},{"word":"face,","start":116.065,"end":116.705},{"word":"and","start":116.705,"end":116.985},{"word":"said:","start":116.985,"end":117.425}]},{"id":35,"speaker":"virgil","text":"\"Righteous soul,\nblessed is the woman who carried you.\nThat was an arrogant man in the world above.\nNo goodness adorns his memory—\nso here his shadow rages with fury.\nHow many who think themselves great kings up there\nwill wallow here like pigs in filth,\nleaving behind only horrible disgrace.","startTime":117.425,"endTime":140.09,"words":[{"word":"\"Righteous","start":117.69,"end":118.25},{"word":"soul,","start":118.25,"end":119.29},{"word":"blessed","start":119.29,"end":119.93},{"word":"is","start":119.93,"end":120.09},{"word":"the","start":120.09,"end":120.25},{"word":"woman","start":120.25,"end":120.65},{"word":"who","start":120.65,"end":120.81},{"word":"carried","start":120.81,"end":121.29},{"word":"you.","start":121.29,"end":122.17},{"word":"That","start":122.17,"end":122.41},{"word":"was","start":122.41,"end":122.57},{"word":"an","start":122.57,"end":122.81},{"word"