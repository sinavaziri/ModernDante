,{"word":"before","start":83.066,"end":83.306},{"word":"me,","start":83.306,"end":83.826},{"word":"caked","start":83.826,"end":84.186},{"word":"with","start":84.186,"end":84.426},{"word":"mud:","start":84.426,"end":84.985}]},{"id":9,"speaker":"filippo_argenti","text":"Who are you, coming here before your time?","startTime":84.985,"endTime":87.785,"words":[{"word":"Who","start":84.985,"end":85.345},{"word":"are","start":85.345,"end":85.545},{"word":"you,","start":85.545,"end":86.105},{"word":"coming","start":86.105,"end":86.425},{"word":"here","start":86.425,"end":86.745},{"word":"before","start":86.745,"end":86.985},{"word":"your","start":86.985,"end":87.345},{"word":"time?","start":87.345,"end":87.785}]},{"id":10,"speaker":"dante","text":"Though I come,\" I replied, \"I do not stay.\nBut who are you, so filthy and degraded?","startTime":87.785,"endTime":94.585,"words":[{"word":"Though","start":88.025,"end":88.265},{"word":"I","start":88.265,"end":88.425},{"word":"come,\"","start":88.425,"end":89.305},{"word":"I","start":89.305,"end":89.385},{"word":"replied,","start":89.385,"end":90.265},{"word":"\"I","start":90.265,"end":90.465},{"word":"do","start":90.465,"end":90.585},{"word":"not","start":90.585,"end":90.825},{"word":"stay.","start":90.825,"end":91.785},{"word":"But","start":91.785,"end":91.945},{"word":"who","start":91.945,"end":92.185},{"word":"are","start":92.185,"end":92.425},{"word":"you,","start":92.425,"end":92.905},{"word":"so","start":92.905,"end":93.225},{"word":"filthy","start":93.225,"end":93.625},{"word":"and","start":93.625,"end":93.785},{"word":"degraded?","start":93.785,"end":94.585}]},{"id":11,"speaker":"filippo_argenti","text":"You can see I'm one who weeps,\" he answered.","startTime":94.585,"endTime":98.105,"words":[{"word":"You","start":94.585,"end":94.865},{"word":"can","start":94.865,"end":95.065},{"word":"see","start":95.065,"end":95.625},{"word":"I'm","start":95.625,"end":95.945},{"word":"one","start":95.945,"end":96.185},{"word":"who","start":96.185,"end":96.425},{"word":"weeps,\"","start":96.425,"end":97.225},{"word":"he","start":97.225,"end":97.625},{"word":"answered.","start":97.625,"end":98.105}]},{"id":12,"speaker":"dante","text":"\"Then weep and wail, accursed spirit,\" I said.\n\"Stay here in your misery—I know who you are\nbeneath all that defilement.","startTime":98.105,"endTime":106.665,"words":[{"word":"\"Then","start":98.398,"end":98.585},{"word":"weep","start":98.585,"end":98.985},{"word":"and","start":98.985,"end":99.225},{"word":"wail,","start":99.225,"end":99.705},{"word":"accursed","start":99.705,"end":100.425},{"word":"spirit,\"","start":100.425,"end":101.305},{"word":"I","start":101.305,"end":101.465},{"word":"said.","start":101.465,"end":102.185},{"word":"\"Stay","start":102.185,"end":102.585},{"word":"here","start":102.585,"end":102.825},{"word":"in","start":102.825,"end":103.025},{"word":"your","start":103.025,"end":103.225},{"word":"misery—I","start":103.225,"end":104.305},{"word":"know","start":104.305,"end":104.505},{"word":"who","start":104.505,"end":104.665},{"word":"you","start":104.665,"end":104.865},{"word":"are","start":104.865,"end":105.038},{"word":"beneath","start":105.038,"end":105.465},{"word":"all","start":105.465,"end":105.705},{"word":"that","start":105.705,"end":105.945},{"word":"defilement.","start":105.945,"end":106.665}]},{"id":13,"speaker":"narrator","text":"He reached both hands toward our boat,\nbut my alert master pushed him away:","startTime":106.665,"endTime":111.385,"words":[{"word":"He","start":106.746,"end":106.866},{"word":"reached","start":106.866,"end":107.346},{"word":"both","start":107.346,"end":107.546},{"word":"hands","start":107.546,"end":107.946},{"word":"toward","start":107.946,"end":108.266},{"word":"our","start":108.266,"end":108.426},{"word":"boat,","start":108.426,"end":109.146},{"word":"but","start":109.146,"end":109.306},{"word":"my","start":109.306,"end":109.586},{"word":"alert","start":109.586,"end":109.866},{"word":"master","start":109.866,"end":110.426},{"word":"pushed","start":110.426,"end":110.706},{"word":"him","start":110.706,"end":110.826},{"word":"away:","start":110.826,"end":111.385}]},{"id":33,"speaker":"virgil","text":"Back with the other dogs!\"","startTime":111.385,"endTime":113.185,"words":[{"word":"Back","start":111.385,"end":111.785},{"word":"with","start":111.785,"end":111.905},{"word":"the","start":111.905,"end":112.025},{"word":"other","start":112.025,"end":112.265},{"word":"dogs!\"","start":112.265,"end":112.985}]},{"id":34,"speaker":"narrator","text":"Then he embraced me,\nkissed my face, and said:","startTime":113.185,"endTime":116.945,"words":[{"word":"Then","start":113.345,"end":113.585},{"word":"he","start":113.585,"end":113.745},{"word":"embraced","start":113.745,"end":114.305},{"word":"me,","start":114.305,"end":115.025},{"word":"kissed","start":115.025,"end":115.345},{"word":"my","start":115.345,"end":115.585},{"word":"face,","start":115.585,"end":116.225},{"word":"and","start":116.225,"end":116.505},{"word":"said:","start":116.505,"end":116.945}]},{"id":35,"speaker":"virgil","text":"\"Righteous soul,\nblessed is the woman who carried you.\nThat was an arrogant man in the world above.\nNo goodness adorns his memory—\nso here his shadow rages with fury.\nHow many who think themselves great kings up there\nwill wallow here like pigs in filth,\nleaving behind only horrible disgrace.","startTime":116.945,"endTime":139.61,"words":[{"word":"\"Righteous","start":117.21,"end":117.77},{"word":"soul,","start":117.77,"end":118.81},{"word":"blessed","start":118.81,"end":119.45},{"word":"is","start":119.45,"end":119.61},{"word":"the","start":119.61,"end":119.77},{"word":"woman","start":119.77,"end":120.17},{"word":"who","start":120.17,"end":120.33},{"word":"carried","start":120.33,"end":120.81},{"word":"you.","start":120.81,"end":121.69},{"word":"That","start":121.69,"end":121.93},{"word":"was","start":121.93,"end":122.09},{"word":"an","start":122.09,"end":122.33},{"word":"arrogant","start":122.33,"end":122.89},{"word":"man","start":122.89,"end":123.17},{"word":"in","start":123.17,"end":123.29},{"word":"the","start":123.29,"end":123.45},{"word":"world","start":123.45,"end":123.93},{"word":"above.","start":123.93,"end":124.81},{"word":"No","start":124.81,"end":125.13},{"word":"goodness","start":125.13,"end":125.65},{"word":"adorns","start":125.65,"end":126.09},{"word":"his","start":126.09,"end":126.33},{"word":"memory—","start":126.33,"end":127.29},{"word":"so","start":127.29,"end":127.53},{"word":"here","start":127.53,"end":128.17},{"word":"his","start":128.17,"end":128.41},{"word":"shadow","start":128.41,"end":128.97},{"word":"rages","start":128.97,"end":129.53},{"word":"with","start":129.53,"end":129.77},{"word":"fury.","start":129.77,"end":130.89},{"word":"How","start":130.89,"end":131.13},{"word":"many","start":131.13,"end":131.45},{"word":"who","start":131.45,"end":131.61},{"word":"think","start":131.61,"end":131.85},{"word":"themselves","start":131.85,"end":132.49},{"word":"great","start":132.49,"end":132.89},{"word":"kings","start":132.89,"end":133.29},{"word":"up","start":133.29,"end":133.45},{"word":"there","start":133.45,"end":134.01},{"word":"will","start":134.01,"end":134.33},{"word":"wallow","start":134.33,"end":134.73},{"word":"here","start":134.73,"end":135.09},{"word":"like","start":135.09,"end":135.37},{"word":"pigs","start":135.37,"end":135.77},{"word":"in","start":135.77,"end":136.09},{"word":"filth,","start":136.09,"end":136.89},{"word":"leaving","start":136.89,"end":137.21},{"word":"behind","start":137.21,"end":137.69},{"word":"only","start":137.69,"end":138.17},{"word":"horrible","start":138.17,"end":138.65},{"word":"disgrace.","start":138.65,"end":139.61}]},{"id":15,"speaker":"dante","text":"Master,\" I said, \"I would be pleased\nto see him dunked into this swill\nbefore we leave this lake behind.","startTime":139.61,"endTime":146.25,"words":[{"word":"Master,\"","start":139.77,"end":140.65},{"word":"I","start":140.65,"end":140.85},{"word":"said,","start":140.85,"end":141.61},{"word":"\"I","start":141.61,"end":141.77},{"word":"would","start":141.77,"end":141.93},{"word":"be","start":141.93,"end":142.09},{"word":"pleased","start":142.09,"end":142.57},{"word":"to","start":142.57,"end":142.73},{"word":"see","start":142.73,"end":142.93},{"word":"him","start":142.93,"end":143.13},{"word":"dunked","start":143.13,"end":143.49},{"word":"into","start":143.49,"end":143.73},{"word":"this","start":143.73,"end":143.93},{"word":"swill","start":143.93,"end":144.49},{"word":"before","start":144.49,"end":144.73},{"word":"we","start":144.73,"end":144.89},{"word":"leave","start":144.89,"end":145.09},{"word":"this","start":145.09,"end":145.33},{"word":"lake","start":145.33,"end":145.57},{"word":"behind.","start":145.57,"end":146.25}]},{"id":16,"speaker":"virgil","text":"Before the shore appears, you will be satisfied. Such a wish\ndeserves to be fulfilled.","startTime":146.25,"endTime":152.89,"words":[{"word":"Before","start":146.25,"end":146.73},{"word":"the","start":146.73,"end":146.89},{"word":"shore","start":146.89,"end":147.21},{"word":"appears,","start":147.21,"end":148.25},{"word":"you","start":148.25,"end":148.49},{"word":"will","start":148.49,"end":148.61},{"word":"be","start":148.61,"end":148.81},{"word":"satisfied.","start":148.81,"end":150.17},{"word":"Such","start":150.17,"end":150.45},{"word":"a","start":150.45,"end":150.57},{"word":"wish","start":150.57,"end":150.97},{"word":"deserves","start":150.97,"end":151.69},{"word":"to","start":151.69,"end":151.85},{"word":"be","start":151.85,"end":152.01},{"word":"fulfilled.","start":152.01,"end":152.89}]},{"id":36,"speaker":"narrator","text":"Soon after, I watched the muddy souls\nmake such havoc of him that I still\npraise and thank God for what I saw.\nThey all screamed:","startTime":152.89,"endTime":162.49,"words":[{"word":"Soon","start":153.21,"end":153.45},{"word":"after,","start":153.45,"end":154.33},{"word":"I","start":154.33,"end":154.61},{"word":"watched","start":154.61,"end":154.89},{"word":"the","start":154.89,"end":155.09},{"word":"muddy","start":155.09,"end":155.45},{"word":"souls","start":155.45,"end":155.97},{"word":"make","start":155.97,"end":156.17},{"word":"such","start":156.17,"end":156.53},{"word":"havoc","start":156.53,"end":156.97},{"word":"of","start":156.97,"end":157.29},{"word":"him","start":157.29,"end":157.57},{"word":"that","start":157.57,"end":157.85},{"word":"I","start":157.85,"end":157.93},{"word":"still","start":157.93,"end":158.33},{"word":"praise","start":158.33,"end":158.85},{"word":"and","start":158.85,"end":159.05},{"word":"thank","start":159.05,"end":159.37},{"word":"God","start":159.37,"end":159.77},{"word":"for","start":159.77,"end":159.93},{"word":"what","start":159.93,"end":160.17},{"word":"I","start":160.17,"end":160.25},{"word":"saw.","start":160.25,"end":161.21},{"word":"They","start":161.21,"end":161.49},{"word":"all","start":161.49,"end":161.69},{"word":"screamed:","start":161.69,"end":162.49}]},{"id":37,"speaker":"souls","text":"\"Get Filippo Argenti!\"","startTime":162.49,"endTime":164.57,"words":[{"word":"\"Get","start":162.49,"end":162.89},{"word":"Filippo","start":162.89,"end":163.45},{"word":"Argenti!\"","start":163.45,"end":164.57}]},{"id":38,"speaker":"narrator","text":"And that enraged Florentine spirit\nturned his teeth upon himself.\nWe left him there—I'll say no more—\nbut cries of anguish struck my ears,\nand I strained my eyes ahead.","startTime":164.57,"endTime":175.785,"words":[{"word":"And","start":164.825,"end":164.985},{"word":"that","start":164.985,"end":165.265},{"word":"enraged","start":165.265,"end":165.865},{"word":"Florentine","start":165.865,"end":166.505},{"word":"spirit","start":166.505,"end":167.025},{"word":"turned","start":167.025,"end":167.225},{"word":"his","start":167.225,"end":167.545},{"word":"teeth","start":167.545,"end":167.785},{"word":"upon","start":167.785,"end":168.145},{"word":"himself.","start":168.145,"end":169.145},{"word":"We","start":169.145,"end":169.345},{"word":"left","start":169.345,"end":169.545},{"word":"him","start":169.545,"end":169.745},{"word":"there—I'll","start":169.745,"end":170.425},{"word":"say","start":170.425,"end":170.585},{"word":"no","start":170.585,"end":170.865},{"word":"more—","start":170.865,"end":171.625},{"word":"but","start":171.625,"end":171.785},{"word":"cries","start":171.785,"end":172.185},{"word":"of","start":172.185,"end":172.425},{"word":"anguish","start":172.425,"end":172.905},{"word":"struck","start":172.905,"end":173.225},{"word":"my","start":173.225,"end":173.385},{"word":"ears,","start":173.385,"end":173.985},{"word":"and","start":173.985,"end":174.265},{"word":"I","start":174.265,"end":174.532},{"word":"strained","start":174.532,"end":174.745},{"word":"my","start":174.745,"end":175.025},{"word":"eyes","start":175.025,"end":175.225},{"word":"ahead.","start":175.225,"end":175.785}]},{"id":39,"speaker":"virgil","text":"Now, my son,\"","startTime":175.785,"endTime":177.42,"words":[{"word":"Now,","start":175.785,"end":176.505},{"word":"my","start":176.505,"end":176.745},{"word":"son,\"","start":176.745,"end":177.42}]},{"id":40,"speaker":"narrator","text":"my good master said,","startTime":177.42,"endTime":179.02,"words":[{"word":"my","start":177.58,"end":177.82},{"word":"good","start":177.82,"end":177.98},{"word":"master","start":177.98,"end":178.46},{"word":"said,","start":178.46,"end":179.02}]},{"id":41,"speaker":"virgil","text":"\"the city approaches whose name is Dis,\nwith its grave citizens and great host.","startTime":179.02,"endTime":185.225,"words":[{"word":"\"the","start":179.225,"end":179.465},{"word":"city","start":179.465,"end":179.865},{"word":"approaches","start":179.865,"end":180.505},{"word":"whose","start":180.505,"end":180.825},{"word":"name","start":180.825,"end":181.225},{"word":"is","start":181.225,"end":181.465},{"word":"Dis,","start":181.465,"end":182.345},{"word":"with","start":182.345,"end":182.505},{"word":"its","start":182.505,"end":182.745},{"word":"grave","start":182.745,"end":183.145},{"word":"citizens","start":183.145,"end":183.985},{"word":"and","start":183.985,"end":184.185},{"word":"great","start":184.185,"end":184.505},{"word":"host.","start":184.505,"end":185.225}]},{"id":19,"speaker":"dante","text":"Master, I can already see its towers\nrising red from the valley there,\nas if they were forged in fire.","startTime":185.225,"endTime":191.865,"words":[{"word":"Master,","start":185.31,"end":186.19},{"word":"I","start":186.19,"end":186.35},{"word":"can","start":186.35,"end":186.59},{"word":"already","start":186.59,"end":186.91},{"word":"see","start":186.91,"end":187.19},{"word":"its","start":187.19,"end":187.39},{"word":"towers","start":187.39,"end":187.87},{"word":"rising","start":187.87,"end":188.35},{"word":"red","start":188.35,"end":188.67},{"word":"from","start":188.67,"end":188.83},{"word":"the","start":188.83,"end":188.99},{"word":"valley","start":188.99,"end":189.31},{"word":"there,","start":189.31,"end":189.977},{"word":"as","start":189.977,"end":190.07},{"word":"if","start":190.07,"end":190.19},{"word":"they","start":190.19,"end":190.39},{"word":"were","start":190.39,"end":190.67},{"word":"forged","start":190.67,"end":191.03},{"word":"in","start":191.03,"end":191.23},{"word":"fire.","start":191.23,"end":191.865}]},{"id":42,"speaker":"virgil","text":"The eternal flames burning within\nmake them glow red,\"","startTime":191.865,"endTime":196.095,"words":[{"word":"The","start":191.865,"end":192.105},{"word":"eternal","start":192.105,"end":192.665},{"word":"flames","start":192.665,"end":193.305},{"word":"burning","start":193.305,"end":193.705},{"word":"within","start":193.705,"end":194.425},{"word":"make","start":194.425,"end":194.665},{"word":"them","start":194.665,"end":194.905},{"word":"glow","start":194.905,"end":195.385},{"word":"red,\"","start":195.385,"end":196.095}]},{"id":43,"speaker":"narrator","text":"he told me,","startTime":196.095,"endTime":197.375,"words":[{"word":"he","start":196.255,"end":196.455},{"word":"told","start":196.455,"end":196.815},{"word":"me,","start":196.815,"end":197.375}]},{"id":44,"speaker":"virgil","text":"\"as you see here in this lower Hell.","startTime":197.375,"endTime":200.345,"words":[{"word":"\"as","start":197.545,"end":197.825},{"word":"you","start":197.825,"end":198.025},{"word":"see","start":198.025,"end":198.265},{"word":"here","start":198.265,"end":198.825},{"word":"in","start":198.825,"end":198.985},{"word":"this","start":198.985,"end":199.305},{"word":"lower","start":199.305,"end":199.705},{"word":"Hell.","start":199.705,"end":200.345}]},{"id":45,"speaker":"narrator","text":"We came at last to the deep moats\nthat circle that city of despair.\nThe walls seemed made of iron.\nAfter sailing a wide circuit,\nwe reached a place where the pilot\ncried out:","startTime":200.345,"endTime":211.895,"words":[{"word":"We","start":200.505,"end":200.665},{"word":"came","start":200.665,"end":200.865},{"word":"at","start":200.865,"end":201.065},{"word":"last","start":201.065,"end":201.625},{"word":"to","start":201.625,"end":201.825},{"word":"the","start":201.825,"end":202.065},{"word":"deep","start":202.065,"end":202.345},{"word":"moats","start":202.345,"end":202.745},{"word":"that","start":202.745,"end":202.985},{"word":"circle","start":202.985,"end":203.385},{"word":"that","start":203.385,"end":203.625},{"word":"city","start":203.625,"end":203.905},{"word":"of","start":203.905,"end":204.025},{"word":"despair.","start":204.025,"end":205.225},{"word":"The","start":205.225,"end":205.385},{"word":"walls","start":205.385,"end":205.905},{"word":"seemed","start":205.905,"end":206.265},{"word":"made","start":206.265,"end":206.465},{"word":"of","start":206.465,"end":206.665},{"word":"iron.","start":206.665,"end":207.785},{"word":"After","start":207.785,"end":208.105},{"word":"sailing","start":208.105,"end":208.505},{"word":"a","start":208.505,"end":208.745},{"word":"wide","start":208.745,"end":208.985},{"word":"circuit,","start":208.985,"end":209.732},{"word":"we","start":209.732,"end":209.865},{"word":"reached","start":209.865,"end":210.185},{"word":"a","start":210.185,"end":210.398},{"word":"place","start":210.398,"end":210.545},{"word":"where","start":210.545,"end":210.665},{"word":"the","start":210.665,"end":210.785},{"word":"pilot","start":210.785,"end":211.225},{"word":"cried","start":211.225,"end":211.465},{"word":"out:","start":211.465,"end":211.895}]},{"id":46,"speaker":"phlegyas","text":"\"Disembark! Here's the entrance!\"","startTime":211.895,"endTime":214.375,"words":[{"word":"\"Disembark!","start":211.895,"end":213.095},{"word":"Here's","start":213.095,"end":213.415},{"word":"the","start":213.415,"end":213.655},{"word":"entrance!\"","start":213.655,"end":214.375}]},{"id":47,"speaker":"narrator","text":"Above the gates I saw more than a thousand\nof those rained down from Heaven, who said angrily:","startTime":214.375,"endTime":220.17,"words":[{"word":"Above","start":214.73,"end":214.97},{"word":"the","start":214.97,"end":215.09},{"word":"gates","start":215.09,"end":215.61},{"word":"I","start":215.61,"end":215.663},{"word":"saw","start":215.663,"end":216.01},{"word":"more","start":216.01,"end":216.17},{"word":"than","start":216.17,"end":216.49},{"word":"a","start":216.49,"end":216.597},{"word":"thousand","start":216.597,"end":217.05},{"word":"of","start":217.05,"end":217.29},{"word":"those","start":217.29,"end":217.53},{"word":"rained","start":217.53,"end":218.01},{"word":"down","start":218.01,"end":218.25},{"word":"from","start":218.25,"end":218.41},{"word":"Heaven,","start":218.41,"end":219.05},{"word":"who","start":219.05,"end":219.25},{"word":"said","start":219.25,"end":219.45},{"word":"angrily:","start":219.45,"end":220.17}]},{"id":22,"speaker":"fallen_angels","text":"Who is this who, without dying,\ntravels through the kingdom of the dead?","startTime":220.17,"endTime":224.49,"words":[{"word":"Who","start":220.17,"end":220.49},{