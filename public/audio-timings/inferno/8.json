":"red,\"","start":195.76,"end":196.47}]},{"id":43,"speaker":"narrator","text":"he told me,","startTime":196.47,"endTime":197.75,"words":[{"word":"he","start":196.63,"end":196.83},{"word":"told","start":196.83,"end":197.19},{"word":"me,","start":197.19,"end":197.75}]},{"id":44,"speaker":"virgil","text":"\"as you see here in this lower Hell.","startTime":197.75,"endTime":200.72,"words":[{"word":"\"as","start":197.92,"end":198.2},{"word":"you","start":198.2,"end":198.4},{"word":"see","start":198.4,"end":198.64},{"word":"here","start":198.64,"end":199.2},{"word":"in","start":199.2,"end":199.36},{"word":"this","start":199.36,"end":199.68},{"word":"lower","start":199.68,"end":200.08},{"word":"Hell.","start":200.08,"end":200.72}]},{"id":45,"speaker":"narrator","text":"We came at last to the deep moats\nthat circle that city of despair.\nThe walls seemed made of iron.\nAfter sailing a wide circuit,\nwe reached a place where the pilot\ncried out:","startTime":200.72,"endTime":212.27,"words":[{"word":"We","start":200.88,"end":201.04},{"word":"came","start":201.04,"end":201.24},{"word":"at","start":201.24,"end":201.44},{"word":"last","start":201.44,"end":202},{"word":"to","start":202,"end":202.2},{"word":"the","start":202.2,"end":202.44},{"word":"deep","start":202.44,"end":202.72},{"word":"moats","start":202.72,"end":203.12},{"word":"that","start":203.12,"end":203.36},{"word":"circle","start":203.36,"end":203.76},{"word":"that","start":203.76,"end":204},{"word":"city","start":204,"end":204.28},{"word":"of","start":204.28,"end":204.4},{"word":"despair.","start":204.4,"end":205.6},{"word":"The","start":205.6,"end":205.76},{"word":"walls","start":205.76,"end":206.28},{"word":"seemed","start":206.28,"end":206.64},{"word":"made","start":206.64,"end":206.84},{"word":"of","start":206.84,"end":207.04},{"word":"iron.","start":207.04,"end":208.16},{"word":"After","start":208.16,"end":208.48},{"word":"sailing","start":208.48,"end":208.88},{"word":"a","start":208.88,"end":209.12},{"word"