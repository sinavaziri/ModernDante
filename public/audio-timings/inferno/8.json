,"end":70.081},{"word":"entered","start":70.081,"end":70.641},{"word":"did","start":70.641,"end":70.801},{"word":"it","start":70.801,"end":70.961},{"word":"seem","start":70.961,"end":71.201},{"word":"to","start":71.201,"end":71.401},{"word":"bear","start":71.401,"end":71.601},{"word":"weight.","start":71.601,"end":72.561},{"word":"As","start":72.561,"end":72.721},{"word":"soon","start":72.721,"end":72.881},{"word":"as","start":72.881,"end":73.041},{"word":"we","start":73.041,"end":73.201},{"word":"were","start":73.201,"end":73.401},{"word":"both","start":73.401,"end":73.601},{"word":"aboard,","start":73.601,"end":74.348},{"word":"the","start":74.348,"end":74.481},{"word":"ancient","start":74.481,"end":74.921},{"word":"prow","start":74.921,"end":75.281},{"word":"began","start":75.281,"end":75.681},{"word":"cutting","start":75.681,"end":76.121},{"word":"through","start":76.121,"end":76.441},{"word":"water","start":76.441,"end":76.721},{"word":"deeper","start":76.721,"end":77.121},{"word":"than","start":77.121,"end":77.241},{"word":"it","start":77.241,"end":77.361},{"word":"was","start":77.361,"end":77.601},{"word":"used","start":77.601,"end":77.801},{"word":"to","start":77.801,"end":77.961},{"word":"displacing.","start":77.961,"end":79.201},{"word":"While","start":79.201,"end":79.361},{"word":"we","start":79.361,"end":79.521},{"word":"traveled","start":79.521,"end":80.041},{"word":"down","start":80.041,"end":80.241},{"word":"that","start":80.241,"end":80.481},{"word":"channel","start":80.481,"end":80.841},{"word":"of","start":80.841,"end":80.961},{"word":"the","start":80.961,"end":81.201},{"word":"dead,","start":81.201,"end":81.761},{"word":"a","start":81.761,"end":81.921},{"word":"figure","start":81.921,"end":82.481},{"word":"rose","start":82.481,"end":82.801},{"word":"before","start":82.801,"end":83.041},{"word":"me,","start":83.041,"end":83.561},{"word":"caked","start":83.561,"end":83.921},{"word":"with","start":83.921,"end":84.161},{"word":"mud:","start":84.161,"e