k regions.","startTime":232.33,"endTime":244.65,"words":[{"word":"You","start":232.33,"end":232.57},{"word":"come","start":232.57,"end":232.97},{"word":"alone,","start":232.97,"end":233.53},{"word":"and","start":233.53,"end":233.69},{"word":"let","start":233.69,"end":233.89},{"word":"him","start":233.89,"end":234.17},{"word":"go—","start":234.17,"end":234.85},{"word":"the","start":234.85,"end":234.97},{"word":"one","start":234.97,"end":235.25},{"word":"who","start":235.25,"end":235.41},{"word":"dared","start":235.41,"end":235.77},{"word":"enter","start":235.77,"end":236.09},{"word":"this","start":236.09,"end":236.49},{"word":"domain.","start":236.49,"end":237.29},{"word":"Let","start":237.29,"end":237.45},{"word":"him","start":237.45,"end":237.73},{"word":"find","start":237.73,"end":237.93},{"word":"his","start":237.93,"end":238.09},{"word":"own","start":238.09,"end":238.41},{"word":"mad","start":238.41,"end":238.73},{"word":"way","start":238.73,"end":238.89},{"word":"back","start":238.89,"end":239.17},{"word":"if","start":239.17,"end":239.29},{"word":"he","start":239.29,"end":239.45},{"word":"can.","start":239.45,"end":240.33},{"word":"You","start":240.33,"end":240.57},{"word":"will","start":240.57,"end":240.73},{"word":"stay","start":240.73,"end":241.05},{"word":"here,","start":241.05,"end":241.85},{"word":"you","start":241.85,"end":242.09},{"word":"who","start":242.09,"end":242.25},{"word":"have","start":242.25,"end":242.57},{"word":"guided","start":242.57,"end":242.85},{"word":"him","start":242.85,"end":243.09},{"word":"through","start":243.09,"end":243.33},{"word":"such","start":243.33,"end":243.61},{"word":"dark","start":243.61,"end":243.93},{"word":"regions.","start":243.93,"end":244.65}]},{"id":25,"speaker":"narrator","text":"Think, reader, how I felt\nat the sound of those cursed words—\nI believed I would never return from here.","startTime":244.65,"endTime":252.09,"words":[{"word":"Think,","start":244.81,"end":245.37},{"word":"reader,","start":245.37,"end":246.17},{"word":"how","start":246.17,"end":246.57},{"word":"I","start":246.57,"end":246.65},{"word":"felt","start":246.65,"end":246.93},{"word":"at","start":246.93,"end":247.05},{"word":"the","start":247.05,"end":247.33},{"word":"sound","start":247.33,"end":247.53},{"word":"of","start":247.53,"end":247.77},{"word":"those","start":247.77,"end":248.01},{"word":"cursed","start":248.01,"end":248.49},{"word":"words—","start":248.49,"end":249.61},{"word":"I","start":249.61,"end":249.717},{"word":"believed","start":249.717,"end":250.09},{"word":"I","start":250.09,"end":250.33},{"word":"would","start":250.33,"end":250.57},{"word":"never","start":250.57,"end":251.05},{"word":"return","start":251.05,"end":251.41},{"word":"from","start":251.41,"end":251.65},{"word":"here.","start":251.65,"end":252.09}]},{"id":26,"speaker":"dante","text":"My dear guide,\" I said, \"you who have given me\nsafety more than seven times,\nwho have pulled me back from dangers that loomed before me,\ndon't abandon me in this ruin.\nIf we can't go forward,\nlet's quickly retrace our steps together.","startTime":252.09,"endTime":266.09,"words":[{"word":"My","start":252.175,"end":252.415},{"word":"dear","start":252.415,"end":252.735},{"word":"guide,\"","start":252.735,"end":253.615},{"word":"I","start":253.615,"end":253.815},{"word":"said,","start":253.815,"end":254.495},{"word":"\"you","start":254.495,"end":254.815},{"word":"who","start":254.815,"end":254.975},{"word":"have","start":254.975,"end":255.175},{"word":"given","start":255.175,"end":255.375},{"word":"me","start":255.375,"end":255.575},{"word":"safety","start":255.575,"end":256.095},{"word":"more","start":256.095,"end":256.335},{"word":"than","start":256.335,"end":256.655},{"word":"seven","start":256.655,"end":256.895},{"word":"times,","start":256.895,"end":257.748},{"word":"who","start":257.748,"end":257.855},{"word":"have","start":257.855,"end":258.015},{"word":"pulled","start":258.015,"end":258.255},{"word":"me","start":258.255,"end":258.