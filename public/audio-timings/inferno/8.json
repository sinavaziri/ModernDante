d.","start":174,"end":174.56}]},{"id":18,"speaker":"virgil","text":"Now, my son,\" my good master said,\n\"the city approaches whose name is Dis,\nwith its grave citizens and great host.","startTime":174.56,"endTime":183.92,"words":[{"word":"Now,","start":174.56,"end":175.28},{"word":"my","start":175.28,"end":175.52},{"word":"son,\"","start":175.52,"end":176.32},{"word":"my","start":176.32,"end":176.48},{"word":"good","start":176.48,"end":176.72},{"word":"master","start":176.72,"end":177.12},{"word":"said,","start":177.12,"end":177.92},{"word":"\"the","start":177.92,"end":178.16},{"word":"city","start":178.16,"end":178.56},{"word":"approaches","start":178.56,"end":179.2},{"word":"whose","start":179.2,"end":179.52},{"word":"name","start":179.52,"end":179.92},{"word":"is","start":179.92,"end":180.16},{"word":"Dis,","start":180.16,"end":181.04},{"word":"with","start":181.04,"end":181.2},{"word":"its","start":181.2,"end":181.44},{"word":"grave","start":181.44,"end":181.84},{"word":"citizens","start":181.84,"end":182.68},{"word":"and","start":182.68,"end":182.88},{"word":"great","start":182.88,"end":183.2},{"word":"host.","start":183.2,"end":183.92}]},{"id":19,"speaker":"dante","text":"Master, I can already see its towers\nrising red from the valley there,\nas if they were forged in fire.","startTime":183.92,"endTime":190.56,"words":[{"word":"Master,","start":184.005,"end":184.885},{"word":"I","start":184.885,"end":185.045},{"word":"can","start":185.045,"end":185.285},{"word":"already","start":185.285,"end":185.605},{"word":"see","start":185.605,"end":185.885},{"word":"its","start":185.885,"end":186.085},{"word":"towers","start":186.085,"end":186.565},{"word":"rising","start":186.565,"end":187.045},{"word":"red","start":187.045,"end":187.365},{"word":"from","start":187.365,"end":187.525},{"word":"the","start":187.525,"end":187.685},{"word":"valley","start":187.685,"end":188.005},{"word":"there,","start":188.005,"end":188.672},{"word":"as","start":188.672,"end":188.765},{