":141.13,"end":141.33},{"word":"said,","start":141.33,"end":142.09},{"word":"\"I","start":142.09,"end":142.25},{"word":"would","start":142.25,"end":142.41},{"word":"be","start":142.41,"end":142.57},{"word":"pleased","start":142.57,"end":143.05},{"word":"to","start":143.05,"end":143.21},{"word":"see","start":143.21,"end":143.41},{"word":"him","start":143.41,"end":143.61},{"word":"dunked","start":143.61,"end":143.97},{"word":"into","start":143.97,"end":144.21},{"word":"this","start":144.21,"end":144.41},{"word":"swill","start":144.41,"end":144.97},{"word":"before","start":144.97,"end":145.21},{"word":"we","start":145.21,"end":145.37},{"word":"leave","start":145.37,"end":145.57},{"word":"this","start":145.57,"end":145.81},{"word":"lake","start":145.81,"end":146.05},{"word":"behind.","start":146.05,"end":146.73}]},{"id":16,"speaker":"virgil","text":"Before the shore appears, you will be satisfied. Such a wish\ndeserves to be fulfilled.","startTime":146.73,"endTime":153.37,"words":[{"word":"Before","start":146.73,"end":147.21},{"word":"the","start":147.21,"end":147.37},{"word":"shore","start":147.37,"end":147.69},{"word":"appears,","start":147.69,"end":148.73},{"word":"you","start":148.73,"end":148.97},{"word":"will","start":148.97,"end":149.09},{"word":"be","start":149.09,"end":149.29},{"word":"satisfied.","start":149.29,"end":150.65},{"word":"Such","start":150.65,"end":150.93},{"word":"a","start":150.93,"end":151.05},{"word":"wish","start":151.05,"end":151.45},{"word":"deserves","start":151.45,"end":152.17},{"word":"to","start":152.17,"end":152.33},{"word":"be","start":152.33,"end":152.49},{"word":"fulfilled.","start":152.49,"end":153.37}]},{"id":36,"speaker":"narrator","text":"Soon after, I watched the muddy souls\nmake such havoc of him that I still\npraise and thank God for what I saw.\nThey all screamed:","startTime":153.37,"endTime":162.97,"words":[{"word":"Soon","start":153.69,"end":153.93},{"word":"after,","start":153.93,"end":154.81},{"word":"I","start":154.81,"end":155.09},{"word":"watched","start":155.09,"end":155.37},{"word":"the","start":155.37,"end":155.57},{"word":"muddy","start":155.57,"end":155.93},{"word":"souls","start":155.93,"end":156.45},{"word":"make","start":156.45,"end":156.65},{"word":"such","start":156.65,"end":157.01},{"word":"havoc","start":157.01,"end":157.45},{"word":"of","start":157.45,"end":157.77},{"word":"him","start":157.77,"end":158.05},{"word":"that","start":158.05,"end":158.33},{"word":"I","start":158.33,"end":158.41},{"word":"still","start":158.41,"end":158.81},{"word":"praise","start":158.81,"end":159.33},{"word":"and","start":159.33,"end":159.53},{"word":"thank","start":159.53,"end":159.85},{"word":"God","start":159.85,"end":160.25},{"word":"for","start":160.25,"end":160.41},{"word":"what","start":160.41,"end":160.65},{"word":"I","start":160.65,"end":160.73},{"word":"saw.","start":160.73,"end":161.69},{"word":"They","start":161.69,"end":161.97},{"word":"all","start":161.97,"end":162.17},{"word":"screamed:","start":162.17,"end":162.97}]},{"id":37,"speaker":"souls","text":"\"Get Filippo Argenti!\"","startTime":162.97,"endTime":165.05,"words":[{"word":"\"Get","start":162.97,"end":163.37},{"word":"Filippo","start":163.37,"end":163.93},{"word":"Argenti!\"","start":163.93,"end":165.05}]},{"id":38,"speaker":"narrator","text":"And that enraged Florentine spirit\nturned his teeth upon himself.\nWe left him there—I'll say no more—\nbut cries of anguish struck my ears,\nand I strained my eyes ahead.","startTime":165.05,"endTime":176.265,"words":[{"word":"And","start":165.305,"end":165.465},{"word":"that","start":165.465,"end":165.745},{"word":"enraged","start":165.745,"end":166.345},{"word":"Florentine","start":166.345,"end":166.985},{"word":"spirit","start":166.985,"end":167.505},{"word":"turned","start":167.505,"end":167.705},{"word":"his","start":167.705,"end":168.025},{"word":"teeth","start":168.025,"end":168.265},{"word":"upon","start":168.265,"end":168.625},{"word":"himself.","start":168.625,"end":169.625},{"word":"We","start":169.625,"end":169.825},{"word":"left","start":169.825,"end":170.025},{"word":"him","start":170.025,"end":170.225},{"word":"there—I'll","start":170.225,"end":170.905},{"word":"say","start":170.905,"end":171.065},{"word":"no","start":171.065,"end":171.345},{"word":"more—","start":171.345,"end":172.105},{"word":"but","start":172.105,"end":172.265},{"word":"cries","start":172.265,"end":172.665},{"word":"of","start":172.665,"end":172.905},{"word":"anguish","start":172.905,"end":173.385},{"word":"struck","start":173.385,"end":173.705},{"word":"my","start":173.705,"end":173.865},{"word":"ears,","start":173.865,"end":174.465},{"word":"and","start":174.465,"end":174.745},{"word":"I","start":174.745,"end":175.012},{"word":"strained","start":175.012,"end":175.225},{"word":"my","start":175.225,"end":175.505},{"word":"eyes","start":175.505,"end":175.705},{"word":"ahead.","start":175.705,"end":176.265}]},{"id":39,"speaker":"virgil","text":"Now, my son,\"","startTime":176.265,"endTime":177.9,"words":[{"word":"Now,","start":176.265,"end":176.985},{"word":"my","start":176.985,"end":177.225},{"word":"son,\"","start":177.225,"end":177.9}]},{"id":40,"speaker":"narrator","text":"my good master said,","startTime":177.9,"endTime":179.5,"words":[{"word":"my","start":178.06,"end":178.3},{"word":"good","start":178.3,"end":178.46},{"word":"master","start":178.46,"end":178.94},{"word":"said,","start":178.94,"end":179.5}]},{"id":41,"speaker":"virgil","text":"\"the city approaches whose name is Dis,\nwith its grave citizens and great host.","startTime":179.5,"endTime":185.705,"words":[{"word":"\"the","start":179.705,"end":179.945},{"word":"city","start":179.945,"end":180.345},{"word":"approaches","start":180.345,"end":180.985},{"word":"whose","start":180.985,"end":181.305},{"word":"name","start":181.305,"end":181.705},{"word":"is","start":181.705,"end":181.945},{"word":"Dis,","start":181.945,"end":182.825},{"word":"with","start":182.825,"end":182.985},{"word":"its","start":182.985,"end":183.225},{"word":"grave","start":183.225,"end":183.625},{"word":"citizens","start":183.625,"end":184.465},{"word":"and","start":184.465,"end":184.665},{"word":"great","start":184.665,"end":184.985},{"word":"host.","start":184.985,"end":185.705}]},{"id":19,"speaker":"dante","text":"Master, I can already see its towers\nrising red from the valley there,\nas if they were forged in fire.","startTime":185.705,"endTime":192.345,"words":[{"word":"Master,","start":185.79,"end":186.67},{"word":"I","start":186.67,"end":186.83},{"word":"can","start":186.83,"end":187.07},{"word":"already","start":187.07,"end":187.39},{"word":"see","start":187.39,"end":187.67},{"word":"its","start":187.67,"end":187.87},{"word":"towers","start":187.87,"end":188.35},{"word":"rising","start":188.35,"end":188.83},{"word":"red","start":188.83,"end":189.15},{"word":"from","start":189.15,"end":189.31},{"word":"the","start":189.31,"end":189.47},{"word":"valley","start":189.47,"end":189.79},{"word":"there,","start":189.79,"end":190.457},{"word":"as","start":190.457,"end":190.55},{"word":"if","start":190.55,"end":190.67},{"word":"they","start":190.67,"end":190.87},{"word":"were","start":190.87,"end":191.15},{"word":"forged","start":191.15,"end":191.51},{"word":"in","start":191.51,"end":191.71},{"word":"fire.","start":191.71,"end":192.345}]},{"id":42,"speaker":"virgil","text":"The eternal flames burning within\nmake them glow red,\"","startTime":192.345,"endTime":196.575,"words":[{"word":"The","start":192.345,"end":192.585},{"word":"eternal","start":192.585,"end":193.145},{"word":"flames","start":193.145,"end":193.785},{"word":"burning","start":193.785,"end":194.185},{"word":"within","start":194.185,"end":194.905},{"word":"make","start":194.905,"end":195.145},{"word":"them","start":195.145,"end":195.385},{"word":"glow","start":195.385,"end":195.865},{"word":"red,\"","start":195.865,"end":196.575}]},{"id":43,"speaker":"narrator","text":"he told me,","startTime":196.575,"endTime":197.855,"words":[{"word":"he","start":196.735,"end":196.935},{"word":"told","start":196.935,"end":197.295},{"word":"me,","start":197.295,"end":197.855}]},{"id":44,"speaker":"virgil","text":"\"as you see here in this lower Hell.","startTime":197.855,"endTime":200.825,"words":[{"word":"\"as","start":198.025,"end":198.305},{"word":"you","start":198.305,"end":198.505},{"word":"see","start":198.505,"end":198.745},{"word":"here","start":198.745,"end":199.305},{"word":"in","start":199.305,"end":199.465},{"word":"this","start":199.465,"end":199.785},{"word":"lower","start":199.785,"end":200.185},{"word":"Hell.","start":200.185,"end":200.825}]},{"id":45,"speaker":"narrator","text":"We came at last to the deep moats\nthat circle that city of despair.\nThe walls seemed made of iron.\nAfter sailing a wide circuit,\nwe reached a place where the pilot\ncried out:","startTime":200.825,"endTime":212.375,"words":[{"word":"We","start":200.985,"end":201.145},{"word":"came","start":201.145,"end":201.345},{"word":"at","start":201.345,"end":201.545},{"word":"last","start":201.545,"end":202.105},{"word":"to","start":202.105,"end":202.305},{"word":"the","start":202.305,"end":202.545},{"word":"deep","start":202.545,"end":202.825},{"word":"moats","start":202.825,"end":203.225},{"word":"that","start":203.225,"end":203.465},{"word":"circle","start":203.465,"end":203.865},{"word":"that","start":203.865,"end":204.105},{"word":"city","start":204.105,"end":204.385},{"word":"of","start":204.385,"end":204.505},{"word":"despair.","start":204.505,"end":205.705},{"word":"The","start":205.705,"end":205.865},{"word":"walls","start":205.865,"end":206.385},{"word":"seemed","start":206.385,"end":206.745},{"word":"made","start":206.745,"end":206.945},{"word":"of","start":206.945,"end":207.145},{"word":"iron.","start":207.145,"end":208.265},{"word":"After","start":208.265,"end":208.585},{"word":"sailing","start":208.585,"end":208.985},{"word":"a","start":208.985,"end":209.225},{"word":"wide","start":209.225,"end":209.465},{"word":"circuit,","start":209.465,"end":210.212},{"word":"we","start":210.212,"end":210.345},{"word":"reached","start":210.345,"end":210.665},{"word":"a","start":210.665,"end":210.878},{"word":"place","start":210.878,"end":211.025},{"word":"where","start":211.025,"end":211.145},{"word":"the","start":211.145,"end":211.265},{"word":"pilot","start":211.265,"end":211.705},{"word":"cried","start":211.705,"end":211.945},{"word":"out:","start":211.945,"end":212.375}]},{"id":46,"speaker":"phlegyas","text":"\"Disembark! Here's the entrance!\"","startTime":212.375,"endTime":215.095,"words":[{"word":"\"Disembark!","start":212.375,"end":213.655},{"word":"Here's","start":213.655,"end":214.015},{"word":"the","start":214.015,"end":214.135},{"word":"entrance!\"","start":214.135,"end":215.095}]},{"id":47,"speaker":"narrator","text":"Above the gates I saw more than a thousand\nof those rained down from Heaven, who said angrily:","startTime":215.095,"endTime":220.89,"words":[{"word":"Above","start":215.45,"end":215.69},{"word":"the","start":215.69,"end":215.81},{"word":"gates","start":215.81,"end":216.33},{"word":"I","start":216.33,"end":216.383},{"word":"saw","start":216.383,"end":216.73},{"word":"more","start":216.73,"end":216.89},{"word":"than","start":216.89,"end":217.21},{"word":"a","start":217.21,"end":217.317},{"word":"thousand","start":217.317,"end":217.77},{"word":"of","start":217.77,"end":218.01},{"word":"those","start":218.01,"end":218.25},{"word":"rained","start":218.25,"end":218.73},{"word":"down","start":218.73,"end":218.97},{"word":"from","start":218.97,"end":219.13},{"word":"Heaven,","start":219.13,"end":219.77},{"word":"who","start":219.77,"end":219.97},{"word":"said","start":219.97,"end":220.17},{"word":"angrily:","start":220.17,"end":220.89}]},{"id":22,"speaker":"fallen_angels","text":"Who is this who, without dying,\ntravels through the kingdom of the dead?","startTime":220.89,"endTime":226.49,"words":[{"word":"Who","start":220.89,"end":221.25},{"word"