61},{"word":"turn","start":109.161,"end":109.481},{"word":"and","start":109.481,"end":109.721},{"word":"see","start":109.721,"end":109.921},{"word":"how","start":109.921,"end":110.041},{"word":"I'm","start":110.041,"end":110.241},{"word":"left","start":110.241,"end":110.641},{"word":"alone","start":110.641,"end":111.041},{"word":"unless","start":111.041,"end":111.281},{"word":"you","start":111.281,"end":111.441},{"word":"wait","start":111.441,"end":111.681},{"word":"for","start":111.681,"end":111.921},{"word":"me!\"","start":111.921,"end":112.4}]},{"id":5,"speaker":"virgil","text":"Son, drag yourself up there,","startTime":112.4,"endTime":114.8,"words":[{"word":"Son,","start":112.4,"end":113.28},{"word":"drag","start":113.28,"end":113.6},{"word":"yourself","start":113.6,"end":114.08},{"word":"up","start":114.08,"end":114.24},{"word":"there,","start":114.24,"end":114.8}]},{"id":6,"speaker":"narrator","text":"pointing to a terrace slightly higher\nthat circles the entire hill on that side.\nHis words spurred me on.\nI strained every muscle, scrambling up behind him\nuntil that ledge lay beneath my feet.\nThere we both sat down,\nturned eastward toward our ascent,\nfor everyone delights in looking back.\nI first directed my eyes to the low shores,\nthen lifted them to the sun, amazed\nthat it struck us from the left.\nThe poet saw I was completely bewildered\nby the chariot of light\nentering between us and the north wind.","startTime":114.8,"endTime":148,"words":[{"word":"pointing","start":114.881,"end":115.281},{"word":"to","start":115.281,"end":115.401},{"word":"a","start":115.401,"end":115.521},{"word":"terrace","start":115.521,"end":116.081},{"word":"slightly","start":116.081,"end":116.561},{"word":"higher","start":116.561,"end":116.961},{"word":"that","start":116.961,"end":117.241},{"word":"circles","start":117.241,"end":117.561},{"word":"the","start":117.561,"end":117.681},{"word":"entire","start":117.681,"end":118.321},{"word":"hill","start":118.321,"end":118.6