":307.805},{"word":"angel","start":307.805,"end":308.085},{"word":"sitting","start":308.085,"end":308.365},{"word":"at","start":308.365,"end":308.485},{"word":"the","start":308.485,"end":308.565},{"word":"gate","start":308.565,"end":308.885},{"word":"wouldn't","start":308.885,"end":309.205},{"word":"let","start":309.205,"end":309.365},{"word":"me","start":309.365,"end":309.685},{"word":"pass","start":309.685,"end":309.925},{"word":"to","start":309.925,"end":310.085},{"word":"my","start":310.085,"end":310.245},{"word":"torment.","start":310.245,"end":311.445},{"word":"Heaven","start":311.445,"end":311.805},{"word":"must","start":311.805,"end":312.005},{"word":"first","start":312.005,"end":312.325},{"word":"revolve","start":312.325,"end":312.885},{"word":"around","start":312.885,"end":313.125},{"word":"me","start":313.125,"end":313.485},{"word":"outside","start":313.485,"end":313.885},{"word":"there","start":313.885,"end":314.085},{"word":"for","start":314.085,"end":314.245},{"word":"as","start":314.245,"end":314.405},{"word":"long","start":314.405,"end":314.605},{"word":"as","start":314.605,"end":314.725},{"word":"it","start":314.725,"end":314.885},{"word":"did","start":314.885,"end":315.205},{"word":"during","start":315.205,"end":315.445},{"word":"my","start":315.445,"end":315.605},{"word":"life,","start":315.605,"end":316.325},{"word":"because","start":316.325,"end":316.565},{"word":"I","start":316.565,"end":316.805},{"word":"postponed","start":316.805,"end":317.285},{"word":"good","start":317.285,"end":317.645},{"word":"intentions","start":317.645,"end":318.205},{"word":"until","start":318.205,"end":318.405},{"word":"the","start":318.405,"end":318.565},{"word":"end—unless","start":318.565,"end":319.845},{"word":"some","start":319.845,"end":320.085},{"word":"prayer","start":320.085,"end":320.485},{"word":"brings","start":320.485,"end":320.805},{"word":"me","start":320.805,"end":320.965},{"word":"aid,","start":320.965,"end":321.805},{"word":"rising","start":321.805,