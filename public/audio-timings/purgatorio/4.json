word":"between","start":258.601,"end":258.881},{"word":"them.","start":258.881,"end":259.28}]},{"id":13,"speaker":"dante","text":"Sweet lord,\" I said, \"look at him—\nhe appears more negligent\nthan if Sloth herself were his sister.","startTime":259.28,"endTime":266.56,"words":[{"word":"Sweet","start":259.602,"end":260.162},{"word":"lord,\"","start":260.162,"end":261.042},{"word":"I","start":261.042,"end":261.322},{"word":"said,","start":261.322,"end":261.922},{"word":"\"look","start":261.922,"end":262.162},{"word":"at","start":262.162,"end":262.362},{"word":"him—","start":262.362,"end":263.042},{"word":"he","start":263.042,"end":263.242},{"word":"appears","start":263.242,"end":263.642},{"word":"more","start":263.642,"end":263.842},{"word":"negligent","start":263.842,"end":264.402},{"word":"than","start":264.402,"end":264.562},{"word":"if","start":264.562,"end":264.722},{"word":"Sloth","start":264.722,"end":265.042},{"word":"herself","start":265.042,"end":265.642},{"word":"were","start":265.642,"end":265.802},{"word":"his","start":265.802,"end":266.055},{"word":"sister.","start":266.055,"end":266.56}]},{"id":14,"speaker":"narrator","text":"Then he turned toward us and paid attention,\nbarely lifting his gaze above his thigh:","startTime":266.56,"endTime":272.08,"words":[{"word":"Then","start":266.72,"end":266.96},{"word":"he","start":266.96,"end":267.28},{"word":"turned","start":267.28,"end":267.52},{"word":"toward","start":267.52,"end":267.84},{"word":"us","start":267.84,"end":268.2},{"word":"and","start":268.2,"end":268.4},{"word":"paid","start":268.4,"end":268.56},{"word":"attention,","start":268.56,"end":269.68},{"word":"barely","start":269.68,"end":270.24},{"word":"lifting","start":270.24,"end":270.48},{"word":"his","start":270.48,"end":270.68},{"word":"gaze","start":270.68,"end":271.04},{"word":"above","start":271.04,"end":271.4},{"word":"his","start":271.4,"end":271.56},{"word":"thigh:","start":271.56,"end":272.08}]},{"id":15,"speaker":"belacqua","text":"Go on up then, since you're so eager.","startTime":272.08,"endTime":274.64,"words":[{"word":"Go","start":272.08,"end":272.4},{"word":"on","start":272.4,"end":272.56},{"word":"up","start":272.56,"end":272.72},{"word":"then,","start":272.72,"end":273.28},{"word":"since","start":273.28,"end":273.52},{"word":"you're","start":273.52,"end":273.8},{"word":"so","start":273.8,"end":274.08},{"word":"eager.","start":274.08,"end":274.64}]},{"id":21,"speaker":"narrator","text":"Then I knew who he was. The breathlessness\nthat still quickened my breathing a little\ndidn't stop me from going to him.\nAfter I reached him, he barely raised his head,\nsaying:","startTime":274.64,"endTime":285.93,"words":[{"word":"Then","start":274.8,"end":275.28},{"word":"I","start":275.28,"end":275.6},{"word":"knew","start":275.6,"end":275.84},{"word":"who","start":275.84,"end":276.08},{"word":"he","start":276.08,"end":276.24},{"word":"was.","start":276.24,"end":277.28},{"word":"The","start":277.28,"end":277.52},{"word":"breathlessness","start":277.52,"end":278.24},{"word":"that","start":278.24,"end":278.48},{"word":"still","start":278.48,"end":278.8},{"word":"quickened","start":278.8,"end":279.2},{"word":"my","start":279.2,"end":279.44},{"word":"breathing","start":279.44,"end":279.8},{"word":"a","start":279.8,"end":280},{"word":"little","start":280,"end":280.24},{"word":"didn't","start":280.24,"end":280.56},{"word":"stop","start":280.56,"end":280.88},{"word":"me","start":280.88,"end":281.04},{"word":"from","start":281.04,"end":281.2},{"word":"going","start":281.2,"end":281.52},{"word":"to","start":281.52,"end":281.68},{"word":"him.","start":281.68,"end":282.64},{"word":"After","start":282.64,"end":283.04},{"word":"I","start":283.04,"end":283.093},{"word":"reached","start":283.093,"end":283.6},{"word":"him,","start":283.6,"end":284},{"word":"he","start":284,"end":284.2},{"word":"barely","start":284.2,"end":284.6},{"word":"raised","start":284.6,"end":284.8},{"word":"his","start":284.8,"end":284.96},{"word":"head,","start":284.96,"end":285.36},{"word":"saying:","start":285.36,"end":285.92}]},{"id":22,"speaker":"belacqua","text":"\"Have you clearly seen\nhow the sun drives his chariot\nover your left shoulder?\"","startTime":285.93,"endTime":290.25,"words":[{"word":"\"Have","start":285.93,"end":286.25},{"word":"you","start":286.25,"end":286.41},{"word":"clearly","start":286.41,"end":287.05},{"word":"seen","start":287.05,"end":287.29},{"word":"how","start":287.29,"end":287.45},{"word":"the","start":287.45,"end":287.77},{"word":"sun","start":287.77,"end":287.97},{"word":"drives","start":287.97,"end":288.33},{"word":"his","start":288.33,"end":288.49},{"word":"chariot","start":288.49,"end":289.01},{"word":"over","start":289.01,"end":289.21},{"word":"your","start":289.21,"end":289.41},{"word":"left","start":289.41,"end":289.61},{"word":"shoulder?\"","start":289.61,"end":290.25}]},{"id":23,"speaker":"narrator","text":"His lazy posture and brief words\nbrought a smile to my lips.","startTime":290.25,"endTime":294.245,"words":[{"word":"His","start":290.485,"end":290.725},{"word":"lazy","start":290.725,"end":291.285},{"word":"posture","start":291.285,"end":291.725},{"word":"and","start":291.725,"end":292.005},{"word":"brief","start":292.005,"end":292.245},{"word":"words","start":292.245,"end":292.698},{"word":"brought","start":292.698,"end":292.885},{"word":"a","start":292.885,"end":293.045},{"word":"smile","start":293.045,"end":293.485},{"word":"to","start":293.485,"end":293.605},{"word":"my","start":293.605,"end":293.872},{"word":"lips.","start":293.872,"end":294.245}]},{"id":17,"speaker":"dante","text":"Belacqua,\" I began, \"I no longer\ngrieve for you, but tell me—\nwhy do you sit here?\nAre you waiting for an escort,\nor has your old habit overtaken you?","startTime":294.245,"endTime":304.325,"words":[{"word":"Belacqua,\"","start":294.405,"end":295.365},{"word":"I","start":295.365,"end":295.578},{"word":"began,","start":295.578,"end":296.405},{"word":"\"I","start":296.