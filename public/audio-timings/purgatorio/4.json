"are","start":319.84,"end":320},{"word":"others","start":320,"end":320.4},{"word":"that","start":320.4,"end":320.56},{"word":"heaven","start":320.56,"end":320.88},{"word":"doesn't","start":320.88,"end":321.2},{"word":"hear?","start":321.2,"end":321.76}]},{"id":19,"speaker":"narrator","text":"Meanwhile the poet climbed ahead of me,\nsaying: \"Come now. See how the sun\nhas touched the meridian,\nand night already covers Morocco\nwith her foot from the western shore.\"","startTime":321.76,"endTime":332.72,"words":[{"word":"Meanwhile","start":321.92,"end":322.48},{"word":"the","start":322.48,"end":322.72},{"word":"poet","start":322.72,"end":323.04},{"word":"climbed","start":323.04,"end":323.36},{"word":"ahead","start":323.36,"end":323.68},{"word":"of","start":323.68,"end":323.84},{"word":"me,","start":323.84,"end":324.24},{"word":"saying:","start":324.24,"end":325.12},{"word":"\"Come","start":325.12,"end":325.48},{"word":"now.","start":325.48,"end":326.24},{"word":"See","start":326.24,"end":326.48},{"word":"how","start":326.48,"end":326.64},{"word":"the","start":326.64,"end":326.96},{"word":"sun","start":326.96,"end":327.2},{"word":"has","start":327.2,"end":327.44},{"word":"touched","start":327.44,"end":327.76},{"word":"the","start":327.76,"end":327.84},{"word":"meridian,","start":327.84,"end":328.8},{"word":"and","start":328.8,"end":329.04},{"word":"night","start":329.04,"end":329.28},{"word":"already","start":329.28,"end":329.76},{"word":"covers","start":329.76,"end":330.2},{"word":"Morocco","start":330.2,"end":330.72},{"word":"with","start":330.72,"end":330.92},{"word":"her","start":330.92,"end":331.16},{"word":"foot","start":331.16,"end":331.36},{"word":"from","start":331.36,"end":331.56},{"word":"the","start":331.56,"end":331.8},{"word":"western","start":331.8,"end":332.08},{"word":"shore.\"","start":332.08,"end":332.72}]}]}