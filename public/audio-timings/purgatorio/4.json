,"end":265.68},{"word":"paid","start":265.68,"end":265.84},{"word":"attention,","start":265.84,"end":266.96},{"word":"barely","start":266.96,"end":267.52},{"word":"lifting","start":267.52,"end":267.76},{"word":"his","start":267.76,"end":267.96},{"word":"gaze","start":267.96,"end":268.32},{"word":"above","start":268.32,"end":268.68},{"word":"his","start":268.68,"end":268.84},{"word":"thigh:","start":268.84,"end":269.36}]},{"id":15,"speaker":"belacqua","text":"Go on up then, since you're so eager.","startTime":269.36,"endTime":271.92,"words":[{"word":"Go","start":269.36,"end":269.68},{"word":"on","start":269.68,"end":269.84},{"word":"up","start":269.84,"end":270},{"word":"then,","start":270,"end":270.56},{"word":"since","start":270.56,"end":270.8},{"word":"you're","start":270.8,"end":271.08},{"word":"so","start":271.08,"end":271.36},{"word":"eager.","start":271.36,"end":271.92}]},{"id":21,"speaker":"narrator","text":"Then I knew who he was. The breathlessness\nthat still quickened my breathing a little\ndidn't stop me from going to him.\nAfter I reached him, he barely raised his head,\nsaying:","startTime":271.92,"endTime":283.21,"words":[{"word":"Then","start":272.08,"end":272.56},{"word":"I","start":272.56,"end":272.88},{"word":"knew","start":272.88,"end":273.12},{"word":"who","start":273.12,"end":273.36},{"word":"he","start":273.36,"end":273.52},{"word":"was.","start":273.52,"end":274.56},{"word":"The","start":274.56,"end":274.8},{"word":"breathlessness","start":274.8,"end":275.52},{"word":"that","start":275.52,"end":275.76},{"word":"still","start":275.76,"end":276.08},{"word":"quickened","start":276.08,"end":276.48},{"word":"my","start":276.48,"end":276.72},{"word":"breathing","start":276.72,"end":277.08},{"word":"a","start":277.08,"end":277.28},{"word":"little","start":277.28,"end":277.52},{"word":"didn't","start":277.52,"end":277.84},{"word":"stop","start":277.84,"end":278.16},{"word":"me","start":278.16,"end":278.32},{"word":"from","start":278.32,"end":278.48},