m\nlike a bride, silent and motionless.\n\"This is he who lay upon the breast\nof our Pelican, and this is he\nchosen from the cross for the great office.","startTime":242.16,"endTime":284.32,"words":[{"word":"Let","start":242.32,"end":242.56},{"word":"them","start":242.56,"end":242.72},{"word":"hope","start":242.72,"end":243.04},{"word":"in","start":243.04,"end":243.2},{"word":"you\"","start":243.2,"end":243.84},{"word":"was","start":243.84,"end":244.08},{"word":"heard","start":244.08,"end":244.24},{"word":"above","start":244.24,"end":244.56},{"word":"us,","start":244.56,"end":245.12},{"word":"and","start":245.12,"end":245.36},{"word":"all","start":245.36,"end":245.6},{"word":"the","start":245.6,"end":245.76},{"word":"choirs","start":245.76,"end":246.16},{"word":"responded.","start":246.16,"end":247.52},{"word":"Then","start":247.52,"end":247.96},{"word":"a","start":247.96,"end":248.16},{"word":"light","start":248.16,"end":248.48},{"word":"among","start":248.48,"end":248.76},{"word":"them","start":248.76,"end":249},{"word":"brightened","start":249,"end":249.68},{"word":"so","start":249.68,"end":249.84},{"word":"that","start":249.84,"end":250},{"word":"if","start":250,"end":250.16},{"word":"Cancer","start":250.16,"end":250.68},{"word":"held","start":250.68,"end":250.88},{"word":"such","start":250.88,"end":251.12},{"word":"a","start":251.12,"end":251.2},{"word":"crystal,","start":251.2,"end":252},{"word":"winter","start":252,"end":252.4},{"word":"would","start":252.4,"end":252.56},{"word":"have","start":252.56,"end":252.8},{"word":"a","start":252.8,"end":252.88},{"word":"month","start":252.88,"end":253.2},{"word":"of","start":253.2,"end":253.44},{"word":"one","start":253.44,"end":253.76},{"word":"long","start":253.76,"end":254.24},{"word":"day.","start":254.24,"end":255.52},{"word":"As","start":255.52,"end":255.6},{"word":"a","start":255.6,"end":255.76},{"word":"graceful","start":255.76,"end":256.4},{"word":"girl","start":256.4,"end":256.84},{"word":"rises,","start":