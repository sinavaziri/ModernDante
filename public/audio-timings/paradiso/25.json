rd":"raised","start":96.64,"end":97.04},{"word":"my","start":97.04,"end":97.28},{"word":"eyes","start":97.28,"end":97.72},{"word":"to","start":97.72,"end":97.84},{"word":"the","start":97.84,"end":98.16},{"word":"heights","start":98.16,"end":98.48},{"word":"that","start":98.48,"end":98.68},{"word":"had","start":98.68,"end":98.88},{"word":"bent","start":98.88,"end":99.16},{"word":"them","start":99.16,"end":99.48},{"word":"down","start":99.48,"end":99.84},{"word":"with","start":99.84,"end":100.12},{"word":"too","start":100.12,"end":100.4},{"word":"great","start":100.4,"end":100.64},{"word":"weight.","start":100.64,"end":101.04}]},{"id":5,"speaker":"st_james","text":"Since through his grace our Emperor wills\nthat you should meet face to face, before your death,\nwith his nobles in the most secret chamber,\nso that having seen the truth of this court,\nyou may strengthen in yourself and others\nthe Hope that rightfully inspires love below—\ntell us what Hope is, how your mind\nflowers with it, and where it came to you.","startTime":101.04,"endTime":121.68,"words":[{"word":"Since","start":101.04,"end":101.44},{"word":"through","start":101.44,"end":101.72},{"word":"his","start":101.72,"end":101.92},{"word":"grace","start":101.92,"end":102.32},{"word":"our","start":102.32,"end":102.56},{"word":"Emperor","start":102.56,"end":103.04},{"word":"wills","start":103.04,"end":103.44},{"word":"that","start":103.44,"end":103.6},{"word":"you","start":103.6,"end":103.76},{"word":"should","start":103.76,"end":103.92},{"word":"meet","start":103.92,"end":104.24},{"word":"face","start":104.24,"end":104.56},{"word":"to","start":104.56,"end":104.72},{"word":"face,","start":104.72,"end":105.44},{"word":"before","start":105.44,"end":105.68},{"word":"your","start":105.68,"end":106},{"word":"death,","start":106,"end":106.56},{"word":"with","start":106.56,"end":106.72},{"word":"his","start":106.72,"end":106.88},{"word":"nobles","start":106.88,"end":107.32},{"word":"in","start":107.32,"end":107.4