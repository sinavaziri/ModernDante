,"end":314.56},{"word":"wind","start":314.56,"end":315.12},{"word":"brought","start":315.12,"end":315.52},{"word":"forth","start":315.52,"end":315.92},{"word":"the","start":315.92,"end":316.08},{"word":"third","start":316.08,"end":316.56},{"word":"and","start":316.56,"end":316.88},{"word":"final","start":316.88,"end":317.28},{"word":"power.","start":317.28,"end":317.92}]},{"id":12,"speaker":"narrator","text":"She spoke thus to me, then began\nsinging \"Ave Maria,\" and while singing\nvanished like something heavy through deep water.\nMy sight followed her as long as possible,\nand when I lost her, turned back\ntoward the target of greater desire,\nwholly returning to Beatrice.\nBut she flashed such lightning into my eyes\nthat at first my sight couldn't bear it,\nand this made me slower in my questioning.","startTime":317.92,"endTime":342.56,"words":[{"word":"She","start":318.08,"end":318.32},{"word":"spoke","start":318.32,"end":318.64},{"word":"thus","start":318.64,"end":318.96},{"word":"to","start":318.96,"end":319.16},{"word":"me,","start":319.16,"end":319.76},{"word":"then","start":319.76,"end":320.027},{"word":"began","start":320.027,"end":320.4},{"word":"singing","start":320.4,"end":320.96},{"word":"\"Ave","start":320.96,"end":321.36},{"word":"Maria,\"","start":321.36,"end":322.48},{"word":"and","start":322.48,"end":322.64},{"word":"while","start":322.64,"end":322.96},{"word":"singing","start":322.96,"end":323.52},{"word":"vanished","start":323.52,"end":324.08},{"word":"like","start":324.08,"end":324.48},{"word":"something","start":324.48,"end":324.92},{"word":"heavy","start":324.92,"end":325.2},{"word":"through","start":325.2,"end":325.56},{"word":"deep","start":325.56,"end":325.76},{"word":"water.","start":325.76,"end":326.8},{"word":"My","start":326.8,"end":327.04},{"word":"sight","start":327.04,"end":327.36},{"word":"followed","start":327.36,"end":327.76},{"word":"her","start":327.76,"end":327.96},{"word":"as","start":327.96,"end":328.16},{"word":"long","s