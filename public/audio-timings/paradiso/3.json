did, with gesture and word,\nto learn from her what web it was\nwhere she failed to draw the shuttle to the end.","startTime":232.575,"endTime":255.695,"words":[{"word":"Then","start":232.735,"end":232.935},{"word":"it","start":232.935,"end":233.055},{"word":"became","start":233.055,"end":233.535},{"word":"clear","start":233.535,"end":234.015},{"word":"how","start":234.015,"end":234.335},{"word":"everywhere","start":234.335,"end":234.895},{"word":"in","start":234.895,"end":235.055},{"word":"heaven","start":235.055,"end":235.375},{"word":"is","start":235.375,"end":235.535},{"word":"Paradise,","start":235.535,"end":236.655},{"word":"though","start":236.655,"end":236.815},{"word":"the","start":236.815,"end":236.975},{"word":"grace","start":236.975,"end":237.255},{"word":"of","start":237.255,"end":237.375},{"word":"the","start":237.375,"end":237.535},{"word":"highest","start":237.535,"end":238.015},{"word":"good","start":238.015,"end":238.335},{"word":"doesn't","start":238.335,"end":238.815},{"word":"rain","start":238.815,"end":239.055},{"word":"equally.","start":239.055,"end":240.335},{"word":"But","start":240.335,"end":240.495},{"word":"as","start":240.495,"end":240.655},{"word":"it","start":240.655,"end":240.815},{"word":"happens","start":240.815,"end":241.335},{"word":"when","start":241.335,"end":241.535},{"word":"one","start":241.535,"end":241.775},{"word":"food","start":241.775,"end":242.095},{"word":"satisfies","start":242.095,"end":243.015},{"word":"while","start":243.015,"end":243.255},{"word":"longing","start":243.255,"end":243.615},{"word":"for","start":243.615,"end":243.855},{"word":"another","start":243.855,"end":244.095},{"word":"remains,","start":244.095,"end":245.215},{"word":"so","start":245.215,"end":245.455},{"word":"we","start":245.455,"end":245.655},{"word":"ask","start":245.655,"end":245.855},{"word":"for","start":245.855,"end":246.015},{"word":"one","start":246.015,"end":246.335},{"word":"thing","start":246.335,"end":246.735},{"word":"and","start"