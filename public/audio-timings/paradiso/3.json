did, with gesture and word,\nto learn from her what web it was\nwhere she failed to draw the shuttle to the end.","startTime":230.175,"endTime":253.295,"words":[{"word":"Then","start":230.335,"end":230.535},{"word":"it","start":230.535,"end":230.655},{"word":"became","start":230.655,"end":231.135},{"word":"clear","start":231.135,"end":231.615},{"word":"how","start":231.615,"end":231.935},{"word":"everywhere","start":231.935,"end":232.495},{"word":"in","start":232.495,"end":232.655},{"word":"heaven","start":232.655,"end":232.975},{"word":"is","start":232.975,"end":233.135},{"word":"Paradise,","start":233.135,"end":234.255},{"word":"though","start":234.255,"end":234.415},{"word":"the","start":234.415,"end":234.575},{"word":"grace","start":234.575,"end":234.855},{"word":"of","start":234.855,"end":234.975},{"word":"the","start":234.975,"end":235.135},{"word":"highest","start":235.135,"end":235.615},{"word":"good","start":235.615,"end":235.935},{"word":"doesn't","start":235.935,"end":236.415},{"word":"rain","start":236.415,"end":236.655},{"word":"equally.","start":236.655,"end":237.935},{"word":"But","start":237.935,"end":238.095},{"word":"as","start":238.095,"end":238.255},{"word":"it","start":238.255,"end":238.415},{"word":"happens","start":238.415,"end":238.935},{"word":"when","start":238.935,"end":239.135},{"word":"one","start":239.135,"end":239.375},{"word":"food","start":239.375,"end":239.695},{"word":"satisfies","start":239.695,"end":240.615},{"word":"while","start":240.615,"end":240.855},{"word":"longing","start":240.855,"end":241.215},{"word":"for","start":241.215,"end":241.455},{"word":"another","start":241.455,"end":241.695},{"word":"remains,","start":241.695,"end":242.815},{"word":"so","start":242.815,"end":243.055},{"word":"we","start":243.055,"end":243.255},{"word":"ask","start":243.255,"end":243.455},{"word":"for","start":243.455,"end":243.615},{"word":"one","start":243.615,"end":243.935},{"word":"thing","start":243.935,"end":244.335},{"word":"and","start"