# ElevenLabs API Configuration
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# OpenAI API Configuration (for scripts/colorize-images.js)
OPENAI_API_KEY=your_openai_api_key_here

# fal API Configuration (for animation)
# Get your API key from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_api_key_here

# Usage:
# 1. Copy this file to .env.local
# 2. Replace the placeholder values with your actual API keys
# 3. Never commit .env.local to git (it's in .gitignore)

# Audio tools (optional): the folder tools/audio/backup.mjs copies recorded segments to
AUDIO_BACKUP_DIR=/path/to/backup/folder
